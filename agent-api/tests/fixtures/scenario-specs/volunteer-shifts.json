{
  "auth": {
    "emailVerification": false,
    "passwordReset": false,
    "roles": [
      "volunteer",
      "coordinator"
    ],
    "type": "jwt"
  },
  "entities": [
    {
      "description": "Volunteer shift scheduled by food bank coordinators",
      "displayField": "task",
      "fields": [
        {
          "name": "id",
          "primary": true,
          "required": true,
          "type": "uuid"
        },
        {
          "description": "Volunteer duty to perform during the shift",
          "name": "task",
          "required": true,
          "type": "enum",
          "values": [
            "SORTING_DONATIONS",
            "PACKING_BOXES",
            "FRONT_DESK",
            "DELIVERY_DRIVING"
          ]
        },
        {
          "description": "Calendar date of the scheduled shift",
          "index": true,
          "name": "date",
          "required": true,
          "type": "date"
        },
        {
          "description": "Shift start time in HH:MM format",
          "maxLength": 5,
          "name": "startTime",
          "required": true,
          "type": "string"
        },
        {
          "description": "Shift end time in HH:MM format",
          "maxLength": 5,
          "name": "endTime",
          "required": true,
          "type": "string"
        },
        {
          "description": "Full start timestamp for overlap validations",
          "index": true,
          "name": "startsAt",
          "required": true,
          "type": "datetime"
        },
        {
          "description": "Full end timestamp for overlap validations",
          "index": true,
          "name": "endsAt",
          "required": true,
          "type": "datetime"
        },
        {
          "description": "Food bank facility location for the shift",
          "name": "location",
          "required": true,
          "type": "enum",
          "values": [
            "WAREHOUSE",
            "SHOP"
          ]
        },
        {
          "description": "Maximum number of volunteers required for the shift",
          "max": 50,
          "min": 1,
          "name": "capacity",
          "required": true,
          "type": "integer"
        },
        {
          "default": false,
          "description": "Whether this shift strictly requires a verified driver licence",
          "name": "requiresLicence",
          "required": true,
          "type": "boolean"
        },
        {
          "default": "PUBLISHED",
          "description": "Status of shift publication",
          "name": "status",
          "required": true,
          "type": "enum",
          "values": [
            "PUBLISHED",
            "COMPLETED",
            "CANCELLED"
          ]
        },
        {
          "maxLength": 1000,
          "name": "notes",
          "nullable": true,
          "required": false,
          "type": "text"
        },
        {
          "default": "now",
          "name": "createdAt",
          "required": true,
          "type": "datetime"
        }
      ],
      "indexes": [
        {
          "fields": [
            "date",
            "startTime"
          ],
          "name": "idx_shift_datetime"
        }
      ],
      "name": "Shift"
    },
    {
      "description": "Volunteer sign-up registration for a specific shift",
      "displayField": "volunteerName",
      "fields": [
        {
          "name": "id",
          "primary": true,
          "required": true,
          "type": "uuid"
        },
        {
          "description": "Foreign key of the scheduled shift",
          "index": true,
          "name": "shiftId",
          "required": true,
          "type": "uuid"
        },
        {
          "description": "User ID of the registered volunteer",
          "index": true,
          "name": "volunteerId",
          "required": true,
          "type": "uuid"
        },
        {
          "description": "Display name of the registered volunteer",
          "maxLength": 100,
          "name": "volunteerName",
          "required": true,
          "type": "string"
        },
        {
          "description": "Copied shift start datetime for direct overlap checking",
          "index": true,
          "name": "startsAt",
          "required": true,
          "type": "datetime"
        },
        {
          "description": "Copied shift end datetime for direct overlap checking",
          "index": true,
          "name": "endsAt",
          "required": true,
          "type": "datetime"
        },
        {
          "default": "CONFIRMED",
          "description": "Status of the shift registration",
          "name": "status",
          "required": true,
          "type": "enum",
          "values": [
            "CONFIRMED",
            "CANCELLED"
          ]
        },
        {
          "description": "Timestamp when the registration was cancelled",
          "name": "cancelledAt",
          "nullable": true,
          "required": false,
          "type": "datetime"
        },
        {
          "maxLength": 500,
          "name": "cancellationReason",
          "nullable": true,
          "required": false,
          "type": "text"
        },
        {
          "description": "Role that initiated the cancellation",
          "name": "cancelledByRole",
          "nullable": true,
          "required": false,
          "type": "enum",
          "values": [
            "VOLUNTEER",
            "COORDINATOR"
          ]
        },
        {
          "default": "now",
          "name": "createdAt",
          "required": true,
          "type": "datetime"
        }
      ],
      "indexes": [
        {
          "fields": [
            "volunteerId",
            "startsAt"
          ],
          "name": "idx_reg_volunteer_time"
        }
      ],
      "name": "Registration"
    },
    {
      "description": "Attendance and service hours record for a volunteer on a shift",
      "displayField": "volunteerName",
      "fields": [
        {
          "name": "id",
          "primary": true,
          "required": true,
          "type": "uuid"
        },
        {
          "description": "Foreign key of the completed shift",
          "index": true,
          "name": "shiftId",
          "required": true,
          "type": "uuid"
        },
        {
          "description": "Foreign key of the volunteer shift registration",
          "index": true,
          "name": "registrationId",
          "required": true,
          "type": "uuid",
          "unique": true
        },
        {
          "description": "User ID of the volunteer who served",
          "index": true,
          "name": "volunteerId",
          "required": true,
          "type": "uuid"
        },
        {
          "description": "Name of the volunteer",
          "maxLength": 100,
          "name": "volunteerName",
          "required": true,
          "type": "string"
        },
        {
          "description": "Calendar date of the shift attended",
          "index": true,
          "name": "shiftDate",
          "required": true,
          "type": "date"
        },
        {
          "default": true,
          "description": "Whether the volunteer attended the shift",
          "name": "attended",
          "required": true,
          "type": "boolean"
        },
        {
          "default": 0,
          "description": "Total hours served on the shift",
          "max": 24,
          "min": 0,
          "name": "hours",
          "required": true,
          "type": "decimal"
        },
        {
          "default": "RECORDED",
          "description": "Status of attendance record",
          "name": "status",
          "required": true,
          "type": "enum",
          "values": [
            "RECORDED"
          ]
        },
        {
          "default": "now",
          "name": "recordedAt",
          "required": true,
          "type": "datetime"
        },
        {
          "maxLength": 500,
          "name": "notes",
          "nullable": true,
          "required": false,
          "type": "text"
        }
      ],
      "indexes": [
        {
          "fields": [
            "shiftDate",
            "attended"
          ],
          "name": "idx_attendance_monthly"
        }
      ],
      "name": "Attendance"
    },
    {
      "name": "User",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "email",
          "type": "string",
          "required": true,
          "unique": true,
          "maxLength": 255
        },
        {
          "name": "role",
          "type": "enum",
          "values": [
            "volunteer",
            "coordinator"
          ],
          "default": "volunteer"
        }
      ],
      "displayField": "email"
    }
  ],
  "operations": [
    {
      "action": "create",
      "entity": "Shift",
      "method": "POST",
      "operationId": "shift.create",
      "path": "/shifts",
      "policy": "coordinatorsOnly",
      "type": "crud"
    },
    {
      "action": "get",
      "auth": "jwt",
      "entity": "Shift",
      "method": "GET",
      "operationId": "shift.get",
      "path": "/shifts/{id}",
      "type": "crud"
    },
    {
      "action": "list",
      "auth": "jwt",
      "entity": "Shift",
      "filters": [
        "task",
        "location",
        "status",
        "date"
      ],
      "method": "GET",
      "operationId": "shift.list",
      "pagination": {
        "defaultLimit": 20,
        "maxLimit": 100
      },
      "path": "/shifts",
      "ranges": [
        "date"
      ],
      "search": [
        "task",
        "location"
      ],
      "sort": [
        "date",
        "startTime"
      ],
      "type": "crud"
    },
    {
      "action": "update",
      "entity": "Shift",
      "method": "PATCH",
      "operationId": "shift.update",
      "path": "/shifts/{id}",
      "policy": "coordinatorsOnly",
      "type": "crud"
    },
    {
      "action": "delete",
      "entity": "Shift",
      "method": "DELETE",
      "operationId": "shift.delete",
      "path": "/shifts/{id}",
      "policy": "coordinatorsOnly",
      "type": "crud"
    },
    {
      "description": "Coordinators review upcoming shifts in the next two weeks that still have open volunteer capacity (registrations < capacity).",
      "method": "GET",
      "operationId": "shift.listNeedingPeople",
      "path": "/shifts/needing-people",
      "policy": "coordinatorsOnly",
      "summary": "List upcoming shifts needing volunteers",
      "type": "custom"
    },
    {
      "action": "create",
      "auth": "jwt",
      "description": "Volunteer registers for an upcoming shift. Checks that the shift is not full, the shift does not overlap with existing confirmed shifts for this volunteer, and delivery driving shifts require a checked driving licence.",
      "entity": "Registration",
      "method": "POST",
      "operationId": "registration.create",
      "path": "/registrations",
      "request": {
        "entity": "Registration",
        "fields": [
          "shiftId",
          "volunteerId",
          "volunteerName",
          "startsAt",
          "endsAt"
        ]
      },
      "rules": [
        "shiftCapacityLimit",
        "noShiftOverlap",
        "uniqueRegistrationPerVolunteer"
      ],
      "type": "crud"
    },
    {
      "action": "get",
      "entity": "Registration",
      "method": "GET",
      "operationId": "registration.get",
      "path": "/registrations/{id}",
      "policy": "ownRegistrations",
      "type": "crud"
    },
    {
      "action": "list",
      "entity": "Registration",
      "filters": [
        "shiftId",
        "volunteerId",
        "status"
      ],
      "method": "GET",
      "operationId": "registration.list",
      "pagination": {
        "defaultLimit": 20,
        "maxLimit": 100
      },
      "path": "/registrations",
      "policy": "ownRegistrations",
      "sort": [
        "startsAt",
        "createdAt"
      ],
      "type": "crud"
    },
    {
      "action": "update",
      "entity": "Registration",
      "method": "PATCH",
      "operationId": "registration.update",
      "path": "/registrations/{id}",
      "policy": "ownRegistrations",
      "request": {
        "entity": "Registration",
        "fields": [
          "cancellationReason"
        ]
      },
      "rules": [
        "cancelledRegistrationIsFinal"
      ],
      "type": "crud"
    },
    {
      "action": "delete",
      "entity": "Registration",
      "method": "DELETE",
      "operationId": "registration.delete",
      "path": "/registrations/{id}",
      "policy": "coordinatorsOnly",
      "rules": [
        "cancelledRegistrationIsFinal"
      ],
      "type": "crud"
    },
    {
      "description": "Community volunteer cancels their shift registration at least 24 hours prior to the shift start. Updates status to CANCELLED and reopens shift capacity.",
      "method": "POST",
      "operationId": "registration.cancel",
      "path": "/registrations/{id}/cancel",
      "policy": "volunteerCancelOwnRegistration",
      "rules": [
        "registrationFlow",
        "cancelledRegistrationIsFinal"
      ],
      "summary": "Volunteer cancel registration (>=24h prior)",
      "type": "custom"
    },
    {
      "description": "Coordinator cancels a shift registration on volunteer request, including late cancellations within 24 hours of start. Updates status to CANCELLED and reopens shift capacity.",
      "method": "POST",
      "operationId": "registration.coordinatorCancel",
      "path": "/registrations/{id}/coordinator-cancel",
      "policy": "coordinatorsOnly",
      "rules": [
        "registrationFlow",
        "cancelledRegistrationIsFinal"
      ],
      "summary": "Coordinator cancel registration on request (<24h prior)",
      "type": "custom"
    },
    {
      "action": "create",
      "description": "Coordinator records volunteer attendance and service hours for a completed shift. Only volunteers with a confirmed registration on the shift can have attendance recorded.",
      "entity": "Attendance",
      "method": "POST",
      "operationId": "attendance.create",
      "path": "/attendances",
      "policy": "coordinatorsOnly",
      "request": {
        "entity": "Attendance",
        "fields": [
          "shiftId",
          "registrationId",
          "volunteerId",
          "volunteerName",
          "shiftDate",
          "attended",
          "hours",
          "notes"
        ]
      },
      "rules": [
        "uniqueAttendancePerShiftRegistration"
      ],
      "type": "crud"
    },
    {
      "action": "get",
      "entity": "Attendance",
      "method": "GET",
      "operationId": "attendance.get",
      "path": "/attendances/{id}",
      "policy": "ownAttendance",
      "type": "crud"
    },
    {
      "action": "list",
      "entity": "Attendance",
      "filters": [
        "shiftId",
        "volunteerId",
        "attended",
        "status"
      ],
      "method": "GET",
      "operationId": "attendance.list",
      "pagination": {
        "defaultLimit": 20,
        "maxLimit": 100
      },
      "path": "/attendances",
      "policy": "ownAttendance",
      "sort": [
        "shiftDate",
        "recordedAt"
      ],
      "type": "crud"
    },
    {
      "action": "update",
      "entity": "Attendance",
      "method": "PATCH",
      "operationId": "attendance.update",
      "path": "/attendances/{id}",
      "policy": "coordinatorsOnly",
      "request": {
        "entity": "Attendance",
        "fields": [
          "attended",
          "hours",
          "notes"
        ]
      },
      "rules": [
        "recordedAttendanceIsFinal"
      ],
      "type": "crud"
    },
    {
      "action": "delete",
      "entity": "Attendance",
      "method": "DELETE",
      "operationId": "attendance.delete",
      "path": "/attendances/{id}",
      "policy": "coordinatorsOnly",
      "type": "crud"
    },
    {
      "aggregate": {
        "dateField": "shiftDate",
        "field": "hours",
        "filters": {
          "attended": true,
          "status": "RECORDED"
        },
        "fn": "sum",
        "period": "month"
      },
      "entity": "Attendance",
      "method": "GET",
      "operationId": "attendance.monthlyTotalHours",
      "path": "/attendances/monthly-hours",
      "policy": "coordinatorsOnly",
      "summary": "Monthly total volunteer hours recorded",
      "type": "aggregate"
    },
    {
      "operationId": "user.list",
      "type": "crud",
      "action": "list",
      "entity": "User",
      "method": "GET",
      "path": "/users",
      "summary": "Find a user",
      "policy": "userDirectory",
      "pagination": {
        "defaultLimit": 20,
        "maxLimit": 100
      },
      "search": [
        "email"
      ],
      "filters": [
        "role"
      ]
    },
    {
      "operationId": "user.get",
      "type": "crud",
      "action": "get",
      "entity": "User",
      "method": "GET",
      "path": "/users/{id}",
      "summary": "A user",
      "policy": "userDirectory"
    },
    {
      "operationId": "shift.countWhereStatusPublished",
      "type": "aggregate",
      "entity": "Shift",
      "method": "GET",
      "path": "/shifts/aggregate/count-where-status-published",
      "summary": "Upcoming Shifts",
      "aggregate": {
        "fn": "count",
        "filters": {
          "status": "PUBLISHED"
        }
      }
    },
    {
      "operationId": "shift.countThisWeekOnDate",
      "type": "aggregate",
      "entity": "Shift",
      "method": "GET",
      "path": "/shifts/aggregate/count-this-week-on-date",
      "summary": "Shifts This Week",
      "aggregate": {
        "fn": "count",
        "period": "week",
        "dateField": "date"
      }
    },
    {
      "operationId": "registration.countWhereStatusConfirmed",
      "type": "aggregate",
      "entity": "Registration",
      "method": "GET",
      "path": "/registrations/aggregate/count-where-status-confirmed",
      "summary": "Active Shift Registrations",
      "aggregate": {
        "fn": "count",
        "filters": {
          "status": "CONFIRMED"
        }
      }
    },
    {
      "operationId": "registration.countByStatus",
      "type": "aggregate",
      "entity": "Registration",
      "method": "GET",
      "path": "/registrations/aggregate/count-by-status",
      "summary": "Registrations by Status",
      "aggregate": {
        "fn": "count",
        "groupBy": "status"
      }
    },
    {
      "operationId": "attendance.sumHoursByShiftId",
      "type": "aggregate",
      "entity": "Attendance",
      "method": "GET",
      "path": "/attendances/aggregate/sum-hours-by-shift-id",
      "summary": "Total Hours by Shift",
      "aggregate": {
        "fn": "sum",
        "field": "hours",
        "groupBy": "shiftId"
      }
    }
  ],
  "policies": [
    {
      "name": "coordinatorsOnly",
      "roles": [
        "coordinator"
      ],
      "type": "role"
    },
    {
      "name": "volunteersOnly",
      "roles": [
        "volunteer"
      ],
      "type": "role"
    },
    {
      "bypassRoles": [
        "coordinator"
      ],
      "name": "ownRegistrations",
      "ownerField": "volunteerId",
      "type": "ownership"
    },
    {
      "name": "volunteerCancelOwnRegistration",
      "ownerField": "volunteerId",
      "type": "ownership"
    },
    {
      "bypassRoles": [
        "coordinator"
      ],
      "name": "ownAttendance",
      "ownerField": "volunteerId",
      "type": "ownership"
    },
    {
      "entity": "Shift",
      "name": "volunteerPublishedShiftsOnly",
      "roles": [
        "volunteer"
      ],
      "type": "visibility",
      "where": {
        "status": "PUBLISHED"
      }
    },
    {
      "name": "userDirectory",
      "type": "role",
      "roles": [
        "coordinator"
      ]
    }
  ],
  "project": {
    "description": "Open Pantry volunteer shift scheduling, capacity monitoring, and attendance tracking for community food bank operations",
    "name": "Open Pantry",
    "slug": "open-pantry"
  },
  "relationships": [
    {
      "foreignKey": "shiftId",
      "from": "Shift",
      "name": "shiftRegistrations",
      "onDelete": "CASCADE",
      "to": "Registration",
      "type": "one-to-many"
    },
    {
      "foreignKey": "shiftId",
      "from": "Shift",
      "name": "shiftAttendances",
      "onDelete": "CASCADE",
      "to": "Attendance",
      "type": "one-to-many"
    },
    {
      "foreignKey": "registrationId",
      "from": "Registration",
      "name": "registrationAttendance",
      "onDelete": "CASCADE",
      "to": "Attendance",
      "type": "one-to-one"
    },
    {
      "name": "attendanceVolunteerId",
      "type": "one-to-many",
      "from": "User",
      "to": "Attendance",
      "foreignKey": "volunteerId",
      "onDelete": "CASCADE"
    }
  ],
  "rules": [
    {
      "description": "A shift that is full takes no more registrations; capacity limit enforced on non-cancelled registrations.",
      "entity": "Registration",
      "id": "shiftCapacityLimit",
      "kind": "capacity",
      "params": {
        "capacityField": "capacity",
        "parent": "shiftId",
        "where": {
          "status": {
            "ne": "CANCELLED"
          }
        }
      }
    },
    {
      "description": "A volunteer cannot be on two shifts that overlap in date and time.",
      "entity": "Registration",
      "id": "noShiftOverlap",
      "kind": "noOverlap",
      "params": {
        "end": "endsAt",
        "scope": [
          "volunteerId"
        ],
        "start": "startsAt",
        "where": {
          "status": {
            "ne": "CANCELLED"
          }
        }
      }
    },
    {
      "description": "A volunteer may only hold one active registration for a specific shift.",
      "entity": "Registration",
      "id": "uniqueRegistrationPerVolunteer",
      "kind": "uniqueTogether",
      "params": {
        "fields": [
          "shiftId",
          "volunteerId"
        ],
        "where": {
          "status": {
            "ne": "CANCELLED"
          }
        }
      }
    },
    {
      "description": "Shift registration status flow: confirmed transitions only to cancelled.",
      "entity": "Registration",
      "id": "registrationFlow",
      "kind": "transition",
      "params": {
        "field": "status",
        "transitions": {
          "CONFIRMED": [
            "CANCELLED"
          ]
        }
      }
    },
    {
      "description": "Cancelled registrations are final and cannot be modified.",
      "entity": "Registration",
      "id": "cancelledRegistrationIsFinal",
      "kind": "immutableAfter",
      "params": {
        "field": "status",
        "states": [
          "CANCELLED"
        ]
      }
    },
    {
      "description": "Only one attendance record per volunteer per shift.",
      "entity": "Attendance",
      "id": "uniqueAttendancePerShiftRegistration",
      "kind": "uniqueTogether",
      "params": {
        "fields": [
          "shiftId",
          "volunteerId"
        ]
      }
    },
    {
      "description": "Recorded attendance records cannot be altered once finalized.",
      "entity": "Attendance",
      "id": "recordedAttendanceIsFinal",
      "kind": "immutableAfter",
      "params": {
        "field": "status",
        "states": [
          "RECORDED"
        ]
      }
    }
  ],
  "seed": [
