{
 "auth": {
  "roles": [
   "cafe_staff",
   "head_baker",
   "bakery_owner"
  ],
  "type": "jwt"
 },
 "entities": [
  {
   "description": "Bakery wholesale product catalogue items",
   "displayField": "name",
   "fields": [
    {
     "name": "id",
     "primary": true,
     "type": "uuid"
    },
    {
     "maxLength": 100,
     "name": "name",
     "required": true,
     "type": "string"
    },
    {
     "name": "category",
     "required": true,
     "type": "enum",
     "values": [
      "bread",
      "viennoiserie",
      "cake"
     ]
    },
    {
     "min": 0,
     "name": "unitPrice",
     "required": true,
     "type": "decimal"
    },
    {
     "default": 1,
     "min": 1,
     "name": "minQuantity",
     "required": true,
     "type": "integer"
    },
    {
     "name": "availableDays",
     "required": true,
     "type": "string"
    },
    {
     "name": "photo",
     "nullable": true,
     "required": false,
     "type": "image"
    },
    {
     "name": "description",
     "nullable": true,
     "required": false,
     "type": "text"
    },
    {
     "default": "now",
     "name": "createdAt",
     "required": true,
     "type": "datetime"
    }
   ],
   "name": "Product"
  },
  {
   "description": "Café or restaurant client profile",
   "displayField": "name",
   "fields": [
    {
     "name": "id",
     "primary": true,
     "type": "uuid"
    },
    {
     "maxLength": 120,
     "name": "name",
     "required": true,
     "type": "string"
    },
    {
     "name": "deliveryAddress",
     "required": true,
     "type": "text"
    },
    {
     "maxLength": 100,
     "name": "contactPerson",
     "required": true,
     "type": "string"
    },
    {
     "maxLength": 30,
     "name": "phone",
     "required": true,
     "type": "string"
    },
    {
     "index": true,
     "name": "ownerId",
     "required": true,
     "type": "uuid"
    },
    {
     "default": "now",
     "name": "createdAt",
     "required": true,
     "type": "datetime"
    }
   ],
   "name": "Cafe"
  },
  {
   "description": "Wholesale order for delivery on a specific date",
   "displayField": "id",
   "fields": [
    {
     "name": "id",
     "primary": true,
     "type": "uuid"
    },
    {
     "index": true,
     "name": "cafeId",
     "required": true,
     "type": "uuid"
    },
    {
     "index": true,
     "name": "ownerId",
     "required": true,
     "type": "uuid"
    },
    {
     "index": true,
     "name": "deliveryDate",
     "required": true,
     "type": "date"
    },
    {
     "default": "submitted",
     "name": "status",
     "required": true,
     "type": "enum",
     "values": [
      "submitted",
      "confirmed",
      "delivered"
     ]
    },
    {
     "default": 0,
     "min": 0,
     "name": "totalAmount",
     "required": true,
     "type": "decimal"
    },
    {
     "index": true,
     "name": "invoiceId",
     "nullable": true,
     "required": false,
     "type": "uuid"
    },
    {
     "default": "now",
     "name": "createdAt",
     "required": true,
     "type": "datetime"
    }
   ],
   "name": "Order"
  },
  {
   "description": "Individual line item in a wholesale order",
   "displayField": "productId",
   "fields": [
    {
     "name": "id",
     "primary": true,
     "type": "uuid"
    },
    {
     "index": true,
     "name": "orderId",
     "required": true,
     "type": "uuid"
    },
    {
     "index": true,
     "name": "productId",
     "required": true,
     "type": "uuid"
    },
    {
     "min": 1,
     "name": "quantity",
     "required": true,
     "type": "integer"
    },
    {
     "min": 0,
     "name": "unitPrice",
     "required": true,
     "type": "decimal"
    },
    {
     "min": 0,
     "name": "subtotal",
     "required": true,
     "type": "decimal"
    },
    {
     "default": "confirmed",
     "name": "status",
     "required": true,
     "type": "enum",
     "values": [
      "confirmed",
      "refused"
     ]
    },
    {
     "name": "refusalReason",
     "nullable": true,
     "required": false,
     "type": "text"
    },
    {
     "default": "now",
     "name": "createdAt",
     "required": true,
     "type": "datetime"
    }
   ],
   "name": "OrderLine"
  },
  {
   "description": "Daily production list aggregating quantities to bake tomorrow",
   "displayField": "productionDate",
   "fields": [
    {
     "name": "id",
     "primary": true,
     "type": "uuid"
    },
    {
     "index": true,
     "name": "productionDate",
     "required": true,
     "type": "date",
     "unique": true
    },
    {
     "default": "in_progress",
     "name": "status",
     "required": true,
     "type": "enum",
     "values": [
      "in_progress",
      "completed"
     ]
    },
    {
     "name": "notes",
     "nullable": true,
     "required": false,
     "type": "text"
    },
    {
     "default": "now",
     "name": "createdAt",
     "required": true,
     "type": "datetime"
    }
   ],
   "name": "ProductionList"
  },
  {
   "description": "Aggregated baking target for a product on a production list",
   "displayField": "productId",
   "fields": [
    {
     "name": "id",
     "primary": true,
     "type": "uuid"
    },
    {
     "index": true,
     "name": "productionListId",
     "required": true,
     "type": "uuid"
    },
    {
     "index": true,
     "name": "productId",
     "required": true,
     "type": "uuid"
    },
    {
     "min": 1,
     "name": "totalQuantity",
     "required": true,
     "type": "integer"
    },
    {
     "default": "now",
     "name": "createdAt",
     "required": true,
     "type": "datetime"
    }
   ],
   "name": "ProductionItem"
  },
  {
   "description": "Monthly invoice aggregating delivered orders for a café",
   "displayField": "billingMonth",
   "fields": [
    {
     "name": "id",
     "primary": true,
     "type": "uuid"
    },
    {
     "index": true,
     "name": "cafeId",
     "required": true,
     "type": "uuid"
    },
    {
     "index": true,
     "name": "ownerId",
     "required": true,
     "type": "uuid"
    },
    {
     "maxLength": 7,
     "name": "billingMonth",
     "required": true,
     "type": "string"
    },
    {
     "min": 0,
     "name": "totalAmount",
     "required": true,
     "type": "decimal"
    },
    {
     "default": "issued",
     "name": "status",
     "required": true,
     "type": "enum",
     "values": [
      "issued",
      "paid"
     ]
    },
    {
     "name": "paidAt",
     "nullable": true,
     "required": false,
     "type": "datetime"
    },
    {
     "default": "now",
     "name": "createdAt",
     "required": true,
     "type": "datetime"
    }
   ],
   "name": "Invoice"
  }
 ],
 "operations": [
  {
   "action": "create",
   "entity": "Product",
   "method": "POST",
   "operationId": "product.create",
   "path": "/products",
   "policy": "bakeryOwnerOnly",
   "type": "crud"
  },
  {
   "action": "get",
   "auth": "jwt",
   "entity": "Product",
   "method": "GET",
   "operationId": "product.get",
   "path": "/products/{id}",
   "type": "crud"
  },
  {
   "action": "list",
   "auth": "jwt",
   "entity": "Product",
   "filters": [
    "category"
   ],
   "method": "GET",
   "operationId": "product.list",
   "pagination": true,
   "path": "/products",
   "search": [
    "name"
   ],
   "sort": [
    "category",
    "name",
    "unitPrice"
   ],
   "type": "crud"
  },
  {
   "action": "update",
   "entity": "Product",
   "method": "PATCH",
   "operationId": "product.update",
   "path": "/products/{id}",
   "policy": "bakeryOwnerOnly",
   "type": "crud"
  },
  {
   "action": "delete",
   "entity": "Product",
   "method": "DELETE",
   "operationId": "product.delete",
   "path": "/products/{id}",
   "policy": "bakeryOwnerOnly",
   "type": "crud"
  },
  {
   "action": "create",
   "auth": "jwt",
   "entity": "Cafe",
   "method": "POST",
   "operationId": "cafe.create",
   "path": "/cafes",
   "type": "crud"
  },
  {
   "action": "get",
   "entity": "Cafe",
   "method": "GET",
   "operationId": "cafe.get",
   "path": "/cafes/{id}",
   "policy": "ownCafes",
   "type": "crud"
  },
  {
   "action": "list",
   "entity": "Cafe",
   "method": "GET",
   "operationId": "cafe.list",
   "pagination": true,
   "path": "/cafes",
   "policy": "ownCafes",
   "search": [
    "name",
    "contactPerson"
   ],
   "sort": [
    "name"
   ],
   "type": "crud"
  },
  {
   "action": "update",
   "entity": "Cafe",
   "method": "PATCH",
   "operationId": "cafe.update",
   "path": "/cafes/{id}",
   "policy": "ownCafes",
   "type": "crud"
  },
  {
   "action": "create",
   "auth": "jwt",
   "description": "Café Staff submits daily wholesale order with delivery date and product quantities before 2 pm the day before delivery. Must meet minimum product quantities.",
   "entity": "Order",
   "method": "POST",
   "operationId": "order.create",
   "path": "/orders",
   "type": "crud"
  },
  {
   "action": "get",
   "entity": "Order",
   "method": "GET",
   "operationId": "order.get",
   "path": "/orders/{id}",
   "policy": "ownOrders",
   "type": "crud"
  },
  {
   "action": "list",
   "entity": "Order",
   "filters": [
    "cafeId",
    "status",
    "deliveryDate",
    "invoiceId"
   ],
   "method": "GET",
   "operationId": "order.list",
   "pagination": true,
   "path": "/orders",
   "policy": "ownOrders",
   "sort": [
    "deliveryDate",
    "createdAt"
   ],
   "type": "crud"
  },
  {
   "action": "update",
   "description": "Café Staff modifies order quantities prior to 2 pm cut-off. Order cannot be changed after cut-off.",
   "entity": "Order",
   "method": "PATCH",
   "operationId": "order.update",
   "path": "/orders/{id}",
   "policy": "ownOrders",
   "rules": [
    "orderDeliveredImmutable"
   ],
   "type": "crud",
   "request": {
    "entity": "Order",
    "fields": [
     "cafeId",
     "ownerId",
     "deliveryDate",
     "totalAmount",
     "invoiceId"
    ]
   }
  },
  {
   "description": "Bakery Owner confirms order for scheduled delivery. Transitions order status to confirmed.",
   "entity": "Order",
   "method": "POST",
   "operationId": "order.confirm",
   "path": "/orders/{id}/confirm",
   "policy": "bakeryOwnerOnly",
   "rules": [
    "orderStatusFlow"
   ],
   "type": "custom",
   "response": {
    "entity": "Order"
   }
  },
  {
   "description": "Bakery Owner marks order delivered following morning drop-off. Only confirmed orders can be marked delivered. Transitions status to delivered.",
   "entity": "Order",
   "method": "POST",
   "operationId": "order.deliver",
   "path": "/orders/{id}/deliver",
   "policy": "bakeryOwnerOnly",
   "rules": [
    "orderStatusFlow"
   ],
   "type": "custom",
   "response": {
    "entity": "Order"
   }
  },
  {
   "action": "create",
   "entity": "OrderLine",
   "method": "POST",
   "operationId": "orderLine.create",
   "path": "/order-lines",
   "type": "crud",
   "auth": "jwt"
  },
  {
   "action": "list",
   "entity": "OrderLine",
   "filters": [
    "orderId",
    "productId",
    "status"
   ],
   "method": "GET",
   "operationId": "orderLine.list",
   "pagination": true,
   "path": "/order-lines",
   "type": "crud",
   "auth": "jwt"
  },
  {
   "description": "Bakery Owner refuses unavailable order line with mandatory reason and confirms remaining lines. Sets line status to refused.",
   "entity": "OrderLine",
   "method": "POST",
   "operationId": "orderLine.refuse",
   "path": "/order-lines/{id}/refuse",
   "policy": "bakeryOwnerOnly",
   "type": "custom",
   "response": {
    "entity": "OrderLine"
   }
  },
  {
   "action": "get",
   "entity": "ProductionList",
   "method": "GET",
   "operationId": "productionList.get",
   "path": "/production-lists/{id}",
   "policy": "bakeryTeam",
   "type": "crud"
  },
  {
   "action": "list",
   "entity": "ProductionList",
   "filters": [
    "status",
    "productionDate"
   ],
   "method": "GET",
   "operationId": "productionList.list",
   "pagination": true,
   "path": "/production-lists",
   "policy": "bakeryTeam",
   "sort": [
    "productionDate"
   ],
   "type": "crud"
  },
  {
   "description": "Head Baker opens/views production list aggregating product quantities for tomorrow across all confirmed orders. Sets status to in_progress.",
   "entity": "ProductionList",
   "method": "POST",
   "operationId": "productionList.generate",
   "path": "/production-lists/generate",
   "policy": "bakeryTeam",
   "type": "custom"
  },
  {
   "action": "list",
   "entity": "ProductionItem",
   "filters": [
    "productionListId",
    "productId"
   ],
   "method": "GET",
   "operationId": "productionItem.list",
   "pagination": true,
   "path": "/production-items",
   "policy": "bakeryTeam",
   "type": "crud"
  },
  {
   "action": "get",
   "entity": "Invoice",
   "method": "GET",
   "operationId": "invoice.get",
   "path": "/invoices/{id}",
   "policy": "ownInvoices",
   "type": "crud"
  },
  {
   "action": "list",
   "entity": "Invoice",
   "filters": [
    "cafeId",
    "status",
    "billingMonth"
   ],
   "method": "GET",
   "operationId": "invoice.list",
   "pagination": true,
   "path": "/invoices",
   "policy": "ownInvoices",
   "sort": [
    "createdAt"
   ],
   "type": "crud"
  },
  {
   "description": "Bakery Owner generates monthly invoice of delivered orders for a café for the billing month. Sets invoice status to issued.",
   "entity": "Invoice",
   "method": "POST",
   "operationId": "invoice.generate",
   "path": "/invoices/generate",
   "policy": "bakeryOwnerOnly",
   "type": "custom"
  },
  {
   "description": "Bakery Owner marks an issued invoice as paid when funds arrive. Invoice must be in issued status.",
   "entity": "Invoice",
   "method": "POST",
   "operationId": "invoice.markPaid",
   "path": "/invoices/{id}/pay",
   "policy": "bakeryOwnerOnly",
   "rules": [
    "invoiceStatusFlow",
    "invoicePaidImmutable"
   ],
   "type": "custom",
   "response": {
    "entity": "Invoice"
   }
  },
  {
   "operationId": "order.countWhereStatusSubmitted",
   "type": "aggregate",
   "entity": "Order",
   "method": "GET",
   "path": "/orders/aggregate/count-where-status-submitted",
   "summary": "Submitted Orders Awaiting Confirmation",
   "aggregate": {
    "fn": "count",
    "filters": {
     "status": "submitted"
    }
   }
  },
  {
   "operationId": "order.countWhereStatusConfirmed",
   "type": "aggregate",
   "entity": "Order",
   "method": "GET",
   "path": "/orders/aggregate/count-where-status-confirmed",
   "summary": "Confirmed Orders for Tomorrow",
   "aggregate": {
    "fn": "count",
    "filters": {
     "status": "confirmed"
    }
   }
  },
  {
   "operationId": "invoice.countWhereStatusIssued",
   "type": "aggregate",
   "entity": "Invoice",
   "method": "GET",
   "path": "/invoices/aggregate/count-where-status-issued",
   "summary": "Unpaid Invoices",
   "aggregate": {
    "fn": "count",
    "filters": {
     "status": "issued"
    }
   }
  },
  {
   "operationId": "invoice.sumTotalAmountWhereStatusIssued",
   "type": "aggregate",
   "entity": "Invoice",
   "method": "GET",
   "path": "/invoices/aggregate/sum-total-amount-where-status-issued",
   "summary": "Total Unpaid Receivables",
   "aggregate": {
    "fn": "sum",
    "field": "totalAmount",
    "filters": {
     "status": "issued"
    }
   }
  },
  {
   "operationId": "orderLine.sumQuantityByProductIdThisMonth",
   "type": "aggregate",
   "entity": "OrderLine",
   "method": "GET",
   "path": "/order-lines/aggregate/sum-quantity-by-product-id-this-month",
   "summary": "Best-Selling Products This Month",
   "aggregate": {
    "fn": "sum",
    "field": "quantity",
    "groupBy": "productId",
    "period": "month",
    "dateField": "createdAt"
   }
  },
  {
   "operationId": "order.countThisMonthOnDeliveryDateWhereStatusDelivered",
   "type": "aggregate",
   "entity": "Order",
   "method": "GET",
   "path": "/orders/aggregate/count-this-month-on-delivery-date-where-status-delivered",
   "summary": "Orders Delivered This Month",
   "aggregate": {
    "fn": "count",
    "period": "month",
    "dateField": "deliveryDate",
    "filters": {
     "status": "delivered"
    }
   }
  }
 ],
 "policies": [
  {
   "name": "bakeryOwnerOnly",
   "roles": [
    "bakery_owner"
   ],
   "type": "role"
  },
  {
   "name": "headBakerOnly",
   "roles": [
    "head_baker"
   ],
   "type": "role"
  },
  {
   "name": "bakeryTeam",
   "roles": [
    "head_baker",
    "bakery_owner"
   ],
   "type": "role"
  },
  {
   "bypassRoles": [
    "bakery_owner"
   ],
   "name": "ownCafes",
   "ownerField": "ownerId",
   "type": "ownership"
  },
  {
   "bypassRoles": [
    "bakery_owner",
    "head_baker"
   ],
   "name": "ownOrders",
   "ownerField": "ownerId",
   "type": "ownership"
  },
  {
   "bypassRoles": [
    "bakery_owner"
   ],
   "name": "ownInvoices",
   "ownerField": "ownerId",
   "type": "ownership"
  }
 ],
 "project": {
  "description": "Maison Levain wholesale bakery ordering, nightly production planning, and monthly billing platform",
  "name": "Maison Levain"
 },
 "relationships": [
  {
   "foreignKey": "productId",
   "from": "Product",
   "name": "productOrderLines",
   "onDelete": "RESTRICT",
   "to": "OrderLine",
   "type": "one-to-many"
  },
  {
   "foreignKey": "cafeId",
   "from": "Cafe",
   "name": "cafeOrders",
   "onDelete": "RESTRICT",
   "to": "Order",
   "type": "one-to-many"
  },
  {
   "foreignKey": "orderId",
   "from": "Order",
   "name": "orderLines",
   "onDelete": "CASCADE",
   "to": "OrderLine",
   "type": "one-to-many"
  },
  {
   "foreignKey": "cafeId",
   "from": "Cafe",
   "name": "cafeInvoices",
   "onDelete": "RESTRICT",
   "to": "Invoice",
   "type": "one-to-many"
  },
  {
   "foreignKey": "invoiceId",
   "from": "Invoice",
   "name": "invoiceOrders",
   "onDelete": "SET NULL",
   "to": "Order",
   "type": "one-to-many"
  },
  {
   "foreignKey": "productionListId",
   "from": "ProductionList",
   "name": "productionListItems",
   "onDelete": "CASCADE",
   "to": "ProductionItem",
   "type": "one-to-many"
  },
  {
   "foreignKey": "productId",
   "from": "Product",
   "name": "productProductionItems",
   "onDelete": "RESTRICT",
   "to": "ProductionItem",
   "type": "one-to-many"
  }
 ],
 "rules": [
  {
   "entity": "Order",
   "id": "orderStatusFlow",
   "kind": "transition",
   "params": {
    "field": "status",
    "transitions": {
     "confirmed": [
      "delivered"
     ],
     "submitted": [
      "confirmed"
     ]
    }
   }
  },
  {
   "entity": "Order",
   "id": "orderDeliveredImmutable",
   "kind": "immutableAfter",
   "params": {
    "field": "status",
    "states": [
     "delivered"
    ]
   }
  },
  {
   "entity": "Invoice",
   "id": "invoiceStatusFlow",
   "kind": "transition",
   "params": {
    "field": "status",
    "transitions": {
     "issued": [
      "paid"
     ]
    }
   }
  },
  {
   "entity": "Invoice",
   "id": "invoicePaidImmutable",
   "kind": "immutableAfter",
   "params": {
    "field": "status",
    "states": [
     "paid"
    ]
   }
  },
  {
   "entity": "ProductionList",
   "id": "productionListStatusFlow",
   "kind": "transition",
   "params": {
    "field": "status",
    "transitions": {
     "in_progress": [
      "completed"
     ]
    }
   }
  }
 ],
 "seed": [
  {
   "entity": "Product",
   "records": [
    {
     "availableDays": "Mon,Tue,Wed,Thu,Fri,Sat,Sun",
     "category": "bread",
