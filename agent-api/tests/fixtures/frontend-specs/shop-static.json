{
  "specVersion": "1.0",
  "project": {
    "name": "Corner Shop",
    "description": "A static shop window with three custom components (Story 17.3); the test fixture of custom components since Story 22.8",
    "mode": "static",
    "locale": "en"
  },
  "theme": { "style": "minimal", "colorScheme": "light", "colors": { "accent": "#0f766e" }, "radius": "md" },
  "layout": {
    "shell": "header-footer",
    "header": {
      "logoText": "Corner Shop",
      "navigation": [
        { "label": "Products", "page": "products" },
        { "label": "Featured", "page": "featured" },
        { "label": "Cart", "page": "cart" }
      ]
    },
    "footer": { "text": "© Corner Shop" }
  },
  "pages": [
    {
      "route": "/",
      "title": "Home",
      "sections": [
        {
          "id": "hero",
          "component": "Hero",
          "content": {
            "heading": "Fresh from the corner",
            "body": "Bread, coffee and the things you run out of.",
            "cta": { "label": "See the products", "page": "products" }
          }
        }
      ]
    },
    {
      "route": "/products",
      "title": "Products",
      "sections": [
        {
          "id": "grid",
          "component": "ProductGrid",
          "data": { "collection": "products", "fields": ["name", "price"] },
          "states": { "empty": "No products yet" }
        }
      ]
    },
    {
      "route": "/featured",
      "title": "Featured",
      "sections": [
        {
          "id": "detail",
          "component": "ProductDetail",
          "data": { "collection": "products", "fields": ["name", "description", "price", "stock"] }
        }
      ]
    },
    {
      "route": "/cart",
      "title": "Cart",
      "sections": [
        {
          "id": "items",
          "component": "CartList",
          "content": { "title": "Your cart" },
          "data": { "collection": "cartItems", "fields": ["product", "quantity"] },
          "states": { "empty": "Your cart is empty" }
        }
      ]
    }
  ],
  "components": [
    {
      "name": "ProductGrid",
      "kind": "composite",
      "uses": ["card", "badge", "pagination", "skeleton"],
      "description": "Product cards with name, price and image; paginated",
      "propsSchema": { "type": "object", "properties": { "limit": { "type": "integer", "default": 12 } } }
    },
    {
      "name": "ProductDetail",
      "kind": "composite",
      "uses": ["card", "badge", "separator"],
      "description": "One product: image, description, price, stock",
      "propsSchema": { "type": "object", "properties": { "id": { "type": "string" } } }
    },
    {
      "name": "CartList",
      "kind": "composite",
      "uses": ["item", "button", "input"],
      "description": "Cart lines with quantity and remove",
      "propsSchema": { "type": "object", "properties": { "title": { "type": "string" } } }
    }
  ],
  "content": [
    {
      "collection": "products",
      "records": [
        { "name": "Sourdough loaf", "description": "Baked this morning.", "price": 4.5, "stock": 12 },
        { "name": "House coffee", "description": "Medium roast, 250 g.", "price": 7.9, "stock": 30 },
        { "name": "Oat milk", "description": "One litre.", "price": 2.2, "stock": 18 }
      ]
    },
    {
      "collection": "cartItems",
      "records": [
        { "product": "Sourdough loaf", "quantity": 1 },
        { "product": "House coffee", "quantity": 2 }
      ]
    }
  ]
}
