#!/usr/bin/env python3
"""Stands in for `agy --input-format stream-json --output-format stream-json` (agy 1.4.x event shapes)."""
import json, os, pathlib, sys, time

message = json.loads(sys.stdin.readline())
prompt = message["message"]["content"]
mode = next((w.split("=", 1)[1] for w in prompt.split() if w.startswith("MODE=")), "ok")
home = pathlib.Path(os.environ["HOME"])
settings = home / ".gemini" / "antigravity-cli" / "settings.json"
home.joinpath("record.json").write_text(json.dumps({
    "argv": sys.argv, "env": dict(os.environ), "prompt": prompt,
    "settings": json.loads(settings.read_text()) if settings.exists() else None}))
out = lambda obj: print(json.dumps(obj), flush=True)
usage = {"input_tokens": 100, "output_tokens": 20, "thinking_tokens": 5, "cache_read_tokens": 40, "total_tokens": 165}

if mode == "auth":
    out({"event": "result", "result": {"conversation_id": "", "status": "ERROR", "response": "",
         "error": "authentication failed or timed out", "duration_seconds": 0, "num_turns": 0, "usage": {}}})
    print("Error: authentication required. Run 'agy' to log in, then retry.", file=sys.stderr)
    sys.exit(1)

out({"event": "init", "conversation_id": "c-1", "init": {"cwd": os.getcwd(), "tools": ["write_file"],
     "permission_mode": "request-review"}})
if mode == "many_turns":
    for i in range(10):
        out({"event": "step_update", "step_update": {"conversation_id": "c-1", "step_index": i,
             "state": "DONE", "step_type": "agent_response", "text_delta": f"thinking {i}"}})
        time.sleep(0.2)
    sys.exit(0)

pathlib.Path("hello.py").write_text("def hello():\n    return 'hi'\n")
out({"event": "step_update", "step_update": {"conversation_id": "c-1", "step_index": 1, "state": "DONE",
     "step_type": "tool", "tool_name": "write_file",
     "tool_info": {"name": "write_file", "parameters": {"TargetFile": f"{os.getcwd()}/hello.py"}, "output": "ok"}}})
out({"event": "step_update", "step_update": {"conversation_id": "c-1", "step_index": 2, "state": "ACTIVE",
     "step_type": "agent_response", "text_delta": "Created "}})
out({"event": "step_update", "step_update": {"conversation_id": "c-1", "step_index": 2, "state": "DONE",
     "step_type": "agent_response", "text_delta": "hello.py."}})
out({"event": "result", "result": {"conversation_id": "c-1", "status": "SUCCESS", "response": "Created hello.py.",
     "duration_seconds": 1.5, "num_turns": 2, "usage": usage}})
