      "name": "ContactInfo",
      "propsType": "ContactInfoProps",
      "usedBy": [
        "contact"
      ],
      "uses": [
        "card"
      ]
    },
    {
      "description": "A form",
      "domain": "sections",
      "file": "src/components/sections/Form.tsx",
      "kind": "section",
      "name": "Form",
      "propsType": "FormProps",
      "usedBy": [
        "product-detail",
        "contact"
      ],
      "uses": [
        "button",
        "checkbox",
        "field",
        "input",
        "select",
        "textarea"
      ]
    },
    {
      "description": "Heading, text, image and a call to action",
      "domain": "sections",
      "file": "src/components/sections/Hero.tsx",
      "kind": "section",
      "name": "Hero",
      "propsType": "HeroProps",
      "usedBy": [
        "home",
        "about"
      ],
      "uses": [
        "button"
      ]
    },
    {
      "description": "One product: image, description, price, stock",
      "domain": "products",
      "file": "src/features/products/components/ProductDetail.tsx",
      "hook": {
        "file": "src/features/products/hooks/use-product-detail.ts",
        "name": "useProductDetail"
      },
      "kind": "composite",
      "name": "ProductDetail",
      "propsType": "ProductDetailProps",
      "usedBy": [
        "product-detail"
      ],
      "uses": [
        "badge",
        "card",
        "separator"
      ]
    },
    {
      "description": "Product cards with name, price and image; paginated",
      "domain": "products",
      "file": "src/features/products/components/ProductGrid.tsx",
      "hook": {
        "file": "src/features/products/hooks/use-product-grid.ts",
        "name": "useProductGrid"
      },
      "kind": "composite",
      "name": "ProductGrid",
      "propsType": "ProductGridProps",
      "usedBy": [
        "products"
      ],
      "uses": [
        "badge",
        "card",
        "pagination",
        "skeleton"
      ]
