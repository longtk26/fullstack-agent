    }
  ],
  "components": [
    {
      "description": "Records as cards",
      "domain": "sections",
      "file": "src/components/sections/CardGrid.tsx",
      "kind": "section",
      "name": "CardGrid",
      "propsType": "CardGridProps",
      "usedBy": [
        "home"
      ],
      "uses": [
        "badge",
        "card",
        "pagination"
      ]
    },
    {
      "description": "Cart lines with quantity and remove",
      "domain": "cart-items",
      "file": "src/features/cart-items/components/CartList.tsx",
      "hook": {
        "file": "src/features/cart-items/hooks/use-cart-list.ts",
        "name": "useCartList"
      },
      "kind": "composite",
      "name": "CartList",
      "propsType": "CartListProps",
      "usedBy": [
        "cart"
      ],
      "uses": [
        "button",
        "input",
        "item"
      ]
    },
    {
      "description": "Address, e-mail, phone, map link",
