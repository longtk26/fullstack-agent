  "content": [
    {
      "collection": "testimonials",
      "file": "src/content/testimonials.json",
      "records": 2
    }
  ],
  "conventions": {
    "colors": "design tokens from globals.css only (bg-primary, text-muted-foreground)",
    "data": "React Query hooks from @/lib/api/queries only; no other network access",
    "forms": "React Hook Form + zodResolver with the schemas in @/lib/forms",
    "hooks": "logic over ~30 lines moves to the component's companion use-*.ts hook",
    "packageManager": "pnpm",
    "reactImports": "named imports only, never `import * as React`",
    "skill": "nextjs-skills",
    "types": "standalone types T-prefixed (TProduct); props <Name>Props; `type` over `interface`"
  },
  "data": [
    {
      "action": "list",
      "fields": [
        "name"
      ],
      "function": "listCategories",
      "hook": "useListCategories",
      "kind": "operation",
      "operationId": "category.list",
      "pageId": "home",
      "params": {
        "sort": "name"
      },
      "queryKey": "categoryKeys.list(params)",
      "section": "categories"
    },
    {
      "action": "list",
      "fields": [
        "name",
        "price",
        "imageUrl"
      ],
      "function": "listProducts",
      "hook": "useListProducts",
      "kind": "operation",
      "operationId": "product.list",
      "pageId": "products",
      "params": {
        "limit": 12,
        "sort": "-createdAt"
      },
      "queryKey": "productKeys.list(params)",
      "section": "grid"
    },
    {
      "action": "get",
      "fields": [
        "name",
        "description",
        "price",
        "imageUrl",
        "stock"
      ],
      "function": "getProduct",
      "hook": "useGetProduct",
      "kind": "operation",
      "operationId": "product.get",
      "pageId": "product-detail",
      "params": {
        "id": "$route.id"
      },
      "queryKey": "productKeys.detail(params)",
      "section": "detail"
    },
    {
      "action": "list",
      "fields": [
        "productId",
        "quantity"
      ],
      "function": "listCartItems",
      "hook": "useListCartItems",
      "kind": "operation",
      "operationId": "cartItem.list",
      "pageId": "cart",
      "params": {
        "sort": "createdAt"
      },
      "queryKey": "cartItemKeys.list(params)",
      "section": "items"
    }
  ],
  "forms": [
    {
      "fields": [
        {
          "hidden": true,
          "name": "productId",
          "required": true,
          "type": "string",
          "value": "$route.id"
        },
        {
          "hidden": false,
          "label": "Quantity",
          "max": 99.0,
          "min": 1.0,
          "name": "quantity",
          "required": true,
          "type": "integer",
          "value": 1
        }
      ],
      "file": "src/lib/forms.ts",
      "function": "createCartItem",
      "hook": "useCreateCartItem",
      "id": "addToCart",
      "onSuccess": {
        "navigate": "/cart",
        "toast": "Added to cart"
      },
      "operationId": "cartItem.create",
      "params": {},
      "requestFields": [
        "productId",
        "quantity"
      ],
      "requestSchema": "#/components/schemas/CreateCartItemRequest",
      "schema": "addToCartSchema",
      "submitLabel": "Add to cart",
      "valuesType": "TAddToCartValues"
    },
    {
      "fields": [
        {
          "hidden": false,
          "label": "Name",
          "maxLength": 120,
          "name": "name",
          "required": true,
          "type": "string"
        },
        {
          "hidden": false,
          "label": "E-mail",
          "name": "email",
          "required": true,
          "type": "email"
        },
        {
          "hidden": false,
          "label": "Message",
          "name": "message",
          "required": true,
          "type": "text"
        }
      ],
      "file": "src/lib/forms.ts",
      "function": "createContactMessage",
      "hook": "useCreateContactMessage",
      "id": "contact",
      "onSuccess": {
        "toast": "Thanks, we will get back to you"
      },
      "operationId": "contactMessage.create",
      "params": {},
      "requestFields": [
        "email",
        "message",
        "name"
      ],
      "requestSchema": "#/components/schemas/CreateContactMessageRequest",
      "schema": "contactSchema",
      "submitLabel": "Send",
      "valuesType": "TContactValues"
    }
  ],
  "planVersion": "1",
  "project": {
    "locale": "en",
    "mode": "dynamic",
    "name": "Corner Shop",
    "slug": "corner-shop"
  },
