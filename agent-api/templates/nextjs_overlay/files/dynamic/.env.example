# Read at runtime (a restart switches them, no rebuild).
# true: the built-in mock API (MSW, the contract's example data); false: the backend at API_BASE_URL.
MOCK_TEST_API=true
API_BASE_URL=http://localhost:8000
# The backend as the Next server reaches it, when that differs from the browser's address (containers); optional.
API_INTERNAL_URL=

# Apps with sign-in (Story 22.7): where a signed-in user's token lives.
#   local  (default) the browser keeps it (localStorage) and sends it as a bearer header; simple, but any script on
#          the page can read it.
#   cookie the Next server keeps it in an httpOnly, SameSite=Lax cookie and forwards calls through /api/backend.
# Use cookie in production.
AUTH_TOKEN_STORAGE=local
