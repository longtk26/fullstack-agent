{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backend-generation-agent.local/schemas/backend-spec-1.0.json",
  "$defs": {
    "Auth": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "jwt",
          "title": "Type",
          "type": "string"
        },
        "userEntity": {
          "default": "User",
          "title": "Userentity",
          "type": "string"
        },
        "loginField": {
          "default": "email",
          "title": "Loginfield",
          "type": "string"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "Auth",
      "type": "object"
    },
    "BackgroundJob": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "title": "Trigger"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name",
        "trigger"
      ],
      "title": "BackgroundJob",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 63,
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "title": "Name",
          "type": "string"
        },
        "table": {
          "anyOf": [
            {
              "maxLength": 63,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldDef"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "indexes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/IndexDef"
          },
          "title": "Indexes",
          "type": "array"
        },
        "uniqueConstraints": {
          "default": [],
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Uniqueconstraints",
          "type": "array"
        }
      },
      "required": [
        "name",
        "fields"
      ],
      "title": "Entity",
      "type": "object"
    },
    "FieldDef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 63,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "uuid",
            "string",
            "text",
            "integer",
            "float",
            "decimal",
            "boolean",
            "date",
            "datetime",
            "enum",
            "json"
          ],
          "title": "Type",
          "type": "string"
        },
        "primary": {
          "default": false,
          "title": "Primary",
          "type": "boolean"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "nullable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nullable"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "index": {
          "default": false,
          "title": "Index",
          "type": "boolean"
        },
        "default": {
          "default": null,
          "title": "Default"
        },
        "values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        },
        "maxLength": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxlength"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "FieldDef",
      "type": "object"
    },
    "FrontendBinding": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "title": "Page",
          "type": "string"
        },
        "componentPath": {
          "title": "Componentpath",
          "type": "string"
        },
        "component": {
          "title": "Component",
          "type": "string"
        },
        "operationId": {
          "title": "Operationid",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "page",
        "componentPath",
        "component",
        "operationId"
      ],
      "title": "FrontendBinding",
      "type": "object"
    },
    "IndexDef": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "fields"
      ],
      "title": "IndexDef",
      "type": "object"
    },
    "Integration": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "config": {
          "additionalProperties": true,
          "default": {},
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "Integration",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "maxLength": 128,
          "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)+$",
          "title": "Operationid",
          "type": "string"
        },
        "type": {
          "enum": [
            "crud",
            "custom"
          ],
          "title": "Type",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "enum": [
                "create",
                "get",
                "list",
                "update",
                "delete"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "maxLength": 255,
          "pattern": "^/[A-Za-z0-9_\\-/{}.]*$",
          "title": "Path",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "auth": {
          "anyOf": [
            {
              "enum": [
                "none",
                "jwt"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auth"
        },
        "policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/PayloadSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/PayloadSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pagination": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/Pagination"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pagination"
        },
        "filters": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "sort": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sort",
          "type": "array"
        },
        "search": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Search",
          "type": "array"
        },
        "rules": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "operationId",
        "type",
        "method",
        "path"
      ],
      "title": "Operation",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "defaultLimit": {
          "default": 20,
          "maximum": 1000,
          "minimum": 1,
          "title": "Defaultlimit",
          "type": "integer"
        },
        "maxLimit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Maxlimit",
          "type": "integer"
        }
      },
      "title": "Pagination",
      "type": "object"
    },
    "PayloadSchema": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "properties": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FieldDef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Properties"
        }
      },
      "title": "PayloadSchema",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "role",
            "ownership"
          ],
          "title": "Type",
          "type": "string"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "ownerField": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ownerfield"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "Policy",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "slug": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slug"
        }
      },
      "required": [
        "name"
      ],
      "title": "Project",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "one-to-one",
            "one-to-many",
            "many-to-many"
          ],
          "title": "Type",
          "type": "string"
        },
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "foreignKey": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Foreignkey"
        },
        "onDelete": {
          "anyOf": [
            {
              "enum": [
                "CASCADE",
                "SET NULL",
                "RESTRICT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ondelete"
        },
        "through": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Through"
        }
      },
      "required": [
        "name",
        "type",
        "from",
        "to"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "transition",
            "immutableAfter",
            "ownerOnly",
            "sumEquals",
            "custom"
          ],
          "title": "Kind",
          "type": "string"
        },
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "title": "Params",
          "type": "object"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "id",
        "kind",
        "entity"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Seed": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "records": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "entity",
        "records"
      ],
      "title": "Seed",
      "type": "object"
    },
    "Stack": {
      "additionalProperties": false,
      "properties": {
        "framework": {
          "const": "fastapi",
          "title": "Framework",
          "type": "string"
        },
        "database": {
          "const": "postgresql",
          "title": "Database",
          "type": "string"
        },
        "orm": {
          "enum": [
            "sqlalchemy",
            "sqlmodel"
          ],
          "title": "Orm",
          "type": "string"
        },
        "migration": {
          "const": "alembic",
          "title": "Migration",
          "type": "string"
        }
      },
      "required": [
        "framework",
        "database",
        "orm",
        "migration"
      ],
      "title": "Stack",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "specVersion": {
      "const": "1.0",
      "title": "Specversion",
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/Project"
    },
    "stack": {
      "$ref": "#/$defs/Stack"
    },
    "entities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "relationships": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Relationship"
      },
      "title": "Relationships",
      "type": "array"
    },
    "operations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "title": "Operations",
      "type": "array"
    },
    "auth": {
      "anyOf": [
        {
          "$ref": "#/$defs/Auth"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Policy"
      },
      "title": "Policies",
      "type": "array"
    },
    "rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "title": "Rules",
      "type": "array"
    },
    "integrations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Integration"
      },
      "title": "Integrations",
      "type": "array"
    },
    "backgroundJobs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BackgroundJob"
      },
      "title": "Backgroundjobs",
      "type": "array"
    },
    "seed": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Seed"
      },
      "title": "Seed",
      "type": "array"
    },
    "x-frontendBindings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FrontendBinding"
      },
      "title": "X-Frontendbindings",
      "type": "array"
    }
  },
  "required": [
    "specVersion",
    "project",
    "stack"
  ],
  "title": "BackendSpec 1.0",
  "type": "object"
}
