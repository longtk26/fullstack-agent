{
  "specVersion": "1.0",
  "project": {
    "name": "Studio Flow",
    "description": "Work and project tracker for a design agency managing client projects, budgets, deadlines, and task workflows."
  },
  "stack": {
    "framework": "fastapi",
    "database": "postgresql",
    "orm": "sqlmodel",
    "migration": "alembic"
  },
  "entities": [
    {
      "name": "Project",
      "displayField": "name",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "maxLength": 120
        },
        {
          "name": "clientName",
          "type": "string",
          "required": true,
          "maxLength": 120
        },
        {
          "name": "budget",
          "type": "decimal",
          "required": true,
          "min": 0
        },
        {
          "name": "spent",
          "type": "decimal",
          "required": false,
          "default": 0,
          "min": 0
        },
        {
          "name": "deadline",
          "type": "date",
          "required": true
        },
        {
          "name": "color",
          "type": "string",
          "required": true,
          "maxLength": 30
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Task",
      "displayField": "title",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "projectId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "maxLength": 160
        },
        {
          "name": "description",
          "type": "text",
          "required": false,
          "nullable": true
        },
        {
          "name": "assigneeName",
          "type": "string",
          "required": true,
          "maxLength": 80
        },
        {
          "name": "priority",
          "type": "enum",
          "values": [
            "LOW",
            "NORMAL",
            "URGENT"
          ],
          "required": true,
          "default": "NORMAL"
        },
        {
          "name": "estimateHours",
          "type": "float",
          "required": true,
          "min": 0
        },
        {
          "name": "dueDate",
          "type": "date",
          "required": true
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "BACKLOG",
            "IN_PROGRESS",
            "IN_REVIEW",
            "DONE"
          ],
          "required": true,
          "default": "BACKLOG"
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    }
  ],
  "relationships": [
    {
      "name": "projectTasks",
      "type": "one-to-many",
      "from": "Project",
      "to": "Task",
      "foreignKey": "projectId",
      "onDelete": "CASCADE"
    }
  ],
  "rules": [
    {
      "id": "taskStatusFlow",
      "kind": "transition",
      "entity": "Task",
      "description": "Tasks move from backlog to in progress, then in review, and done. Tasks in review can also return to in progress.",
      "params": {
        "field": "status",
        "transitions": {
          "BACKLOG": [
            "IN_PROGRESS"
          ],
          "IN_PROGRESS": [
            "IN_REVIEW"
          ],
          "IN_REVIEW": [
            "IN_PROGRESS",
            "DONE"
          ],
          "DONE": []
        }
      }
    }
  ],
  "operations": [
    {
      "operationId": "project.create",
      "type": "crud",
      "action": "create",
      "entity": "Project",
      "method": "POST",
      "path": "/projects"
    },
    {
      "operationId": "project.get",
      "type": "crud",
      "action": "get",
      "entity": "Project",
      "method": "GET",
      "path": "/projects/{id}"
    },
    {
      "operationId": "project.list",
      "type": "crud",
      "action": "list",
      "entity": "Project",
      "method": "GET",
      "path": "/projects",
      "pagination": true,
      "search": [
        "name",
        "clientName"
      ],
      "sort": [
        "deadline",
        "name",
        "budget",
        "createdAt"
      ]
    },
    {
      "operationId": "project.update",
      "type": "crud",
      "action": "update",
      "entity": "Project",
      "method": "PATCH",
      "path": "/projects/{id}"
    },
    {
      "operationId": "project.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Project",
      "method": "DELETE",
      "path": "/projects/{id}"
    },
    {
      "operationId": "task.create",
      "type": "crud",
      "action": "create",
      "entity": "Task",
      "method": "POST",
      "path": "/tasks"
    },
    {
      "operationId": "task.get",
      "type": "crud",
      "action": "get",
      "entity": "Task",
      "method": "GET",
      "path": "/tasks/{id}"
    },
    {
      "operationId": "task.list",
      "type": "crud",
      "action": "list",
      "entity": "Task",
      "method": "GET",
      "path": "/tasks",
      "pagination": true,
      "filters": [
        "projectId",
        "status",
        "priority",
        "assigneeName"
      ],
      "search": [
        "title",
        "assigneeName"
      ],
      "sort": [
        "dueDate",
        "priority",
        "status",
        "createdAt"
      ]
    },
    {
      "operationId": "task.update",
      "type": "crud",
      "action": "update",
      "entity": "Task",
      "method": "PATCH",
      "path": "/tasks/{id}",
      "rules": [
        "taskStatusFlow"
      ]
    },
    {
      "operationId": "task.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Task",
      "method": "DELETE",
      "path": "/tasks/{id}"
    },
    {
      "operationId": "task.countWhereStatusInProgress",
      "type": "aggregate",
      "entity": "Task",
      "method": "GET",
      "path": "/tasks/aggregate/count-where-status-in-progress",
      "summary": "In Progress",
      "aggregate": {
        "fn": "count",
        "filters": {
          "status": "IN_PROGRESS"
        }
      }
    },
    {
      "operationId": "task.countWhereStatusInReview",
      "type": "aggregate",
      "entity": "Task",
      "method": "GET",
      "path": "/tasks/aggregate/count-where-status-in-review",
      "summary": "Awaiting Review",
      "aggregate": {
        "fn": "count",
        "filters": {
          "status": "IN_REVIEW"
        }
      }
    },
    {
      "operationId": "project.count",
      "type": "aggregate",
      "entity": "Project",
      "method": "GET",
      "path": "/projects/aggregate/count",
      "summary": "Active Projects",
      "aggregate": {
        "fn": "count"
      }
    },
    {
      "operationId": "project.sumBudget",
      "type": "aggregate",
      "entity": "Project",
      "method": "GET",
      "path": "/projects/aggregate/sum-budget",
      "summary": "Total Committed Budget",
      "aggregate": {
        "fn": "sum",
        "field": "budget"
      }
    },
    {
      "operationId": "task.countByStatus",
      "type": "aggregate",
      "entity": "Task",
      "method": "GET",
      "path": "/tasks/aggregate/count-by-status",
      "summary": "Tasks by Status",
      "aggregate": {
        "fn": "count",
        "groupBy": "status"
      }
    },
    {
      "operationId": "task.countByPriority",
      "type": "aggregate",
      "entity": "Task",
      "method": "GET",
      "path": "/tasks/aggregate/count-by-priority",
      "summary": "Tasks by Priority",
      "aggregate": {
        "fn": "count",
        "groupBy": "priority"
      }
    }
  ],
