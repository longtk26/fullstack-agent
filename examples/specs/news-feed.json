{
  "specVersion": "1.0",
  "project": {
    "name": "DevPulse",
    "description": "A developer news feed aggregating posts from engineering blogs and communities with bookmarking, tagging, and voting."
  },
  "stack": {
    "framework": "fastapi",
    "database": "postgresql",
    "orm": "sqlmodel",
    "migration": "alembic"
  },
  "auth": {
    "type": "jwt",
    "roles": [
      "member",
      "editor"
    ]
  },
  "entities": [
    {
      "name": "Source",
      "displayField": "name",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "unique": true,
          "maxLength": 80
        },
        {
          "name": "website",
          "type": "string",
          "required": true,
          "maxLength": 255
        },
        {
          "name": "logo",
          "type": "image",
          "required": false,
          "nullable": true
        },
        {
          "name": "description",
          "type": "text",
          "required": false,
          "nullable": true,
          "maxLength": 500
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Tag",
      "displayField": "name",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "unique": true,
          "maxLength": 40
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "nullable": true,
          "maxLength": 200
        }
      ]
    },
    {
      "name": "Post",
      "displayField": "title",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "maxLength": 200
        },
        {
          "name": "summary",
          "type": "text",
          "required": true,
          "maxLength": 1000
        },
        {
          "name": "url",
          "type": "string",
          "required": true,
          "maxLength": 500
        },
        {
          "name": "coverImage",
          "type": "image",
          "required": false,
          "nullable": true
        },
        {
          "name": "sourceId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "readingTime",
          "type": "integer",
          "required": true,
          "min": 1,
          "max": 180
        },
        {
          "name": "upvoteCount",
          "type": "integer",
          "required": true,
          "default": 0,
          "min": 0
        },
        {
          "name": "publishedAt",
          "type": "datetime",
          "required": true,
          "default": "now",
          "index": true
        },
        {
          "name": "isHidden",
          "type": "boolean",
          "required": true,
          "default": false
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Bookmark",
      "displayField": "id",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "ownerId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "postId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    }
  ],
  "relationships": [
    {
      "name": "sourcePosts",
      "type": "one-to-many",
      "from": "Source",
      "to": "Post",
      "foreignKey": "sourceId",
      "onDelete": "CASCADE"
    },
    {
      "name": "postTags",
      "type": "many-to-many",
      "from": "Post",
      "to": "Tag"
    },
    {
      "name": "postBookmarks",
      "type": "one-to-many",
      "from": "Post",
      "to": "Bookmark",
      "foreignKey": "postId",
      "onDelete": "CASCADE"
    }
  ],
  "policies": [
    {
      "name": "editorsOnly",
      "type": "role",
      "roles": [
        "editor"
      ]
    },
    {
      "name": "ownBookmarks",
      "type": "ownership",
      "ownerField": "ownerId",
      "bypassRoles": [
        "editor"
      ]
    }
  ],
  "rules": [
    {
      "id": "singleBookmarkPerUser",
      "kind": "uniqueTogether",
      "entity": "Bookmark",
      "params": {
        "fields": [
          "ownerId",
          "postId"
        ]
      },
      "description": "A member can only bookmark a specific post once"
    }
  ],
  "operations": [
    {
      "operationId": "source.list",
      "type": "crud",
      "action": "list",
      "entity": "Source",
      "method": "GET",
      "path": "/sources",
      "pagination": true,
      "search": [
        "name",
        "website"
      ],
      "sort": [
        "name",
        "createdAt"
      ]
    },
    {
      "operationId": "source.get",
      "type": "crud",
      "action": "get",
      "entity": "Source",
      "method": "GET",
      "path": "/sources/{id}"
    },
    {
      "operationId": "source.create",
      "type": "crud",
      "action": "create",
      "entity": "Source",
      "method": "POST",
      "path": "/sources",
      "policy": "editorsOnly"
    },
    {
      "operationId": "source.update",
      "type": "crud",
      "action": "update",
      "entity": "Source",
      "method": "PATCH",
      "path": "/sources/{id}",
      "policy": "editorsOnly"
    },
    {
      "operationId": "source.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Source",
      "method": "DELETE",
      "path": "/sources/{id}",
      "policy": "editorsOnly"
    },
    {
      "operationId": "tag.list",
      "type": "crud",
      "action": "list",
      "entity": "Tag",
      "method": "GET",
      "path": "/tags",
      "pagination": true,
      "search": [
        "name"
      ],
      "sort": [
        "name"
      ]
    },
    {
      "operationId": "tag.get",
      "type": "crud",
      "action": "get",
      "entity": "Tag",
      "method": "GET",
      "path": "/tags/{id}"
    },
    {
      "operationId": "tag.create",
      "type": "crud",
      "action": "create",
      "entity": "Tag",
      "method": "POST",
      "path": "/tags",
      "policy": "editorsOnly"
    },
    {
      "operationId": "tag.update",
      "type": "crud",
      "action": "update",
      "entity": "Tag",
      "method": "PATCH",
      "path": "/tags/{id}",
      "policy": "editorsOnly"
    },
    {
      "operationId": "tag.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Tag",
      "method": "DELETE",
      "path": "/tags/{id}",
      "policy": "editorsOnly"
    },
    {
      "operationId": "post.list",
      "type": "crud",
      "action": "list",
      "entity": "Post",
      "method": "GET",
      "path": "/posts",
      "pagination": true,
      "filters": [
        "sourceId",
        "isHidden"
      ],
      "search": [
        "title",
        "summary"
      ],
      "sort": [
        "publishedAt",
        "upvoteCount",
        "createdAt"
      ]
    },
    {
      "operationId": "post.get",
      "type": "crud",
      "action": "get",
      "entity": "Post",
      "method": "GET",
      "path": "/posts/{id}"
    },
    {
      "operationId": "post.create",
      "type": "crud",
      "action": "create",
      "entity": "Post",
      "method": "POST",
      "path": "/posts",
      "policy": "editorsOnly"
    },
    {
      "operationId": "post.update",
      "type": "crud",
      "action": "update",
      "entity": "Post",
      "method": "PATCH",
      "path": "/posts/{id}",
      "policy": "editorsOnly"
    },
    {
      "operationId": "post.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Post",
      "method": "DELETE",
      "path": "/posts/{id}",
      "policy": "editorsOnly"
    },
    {
      "operationId": "post.upvote",
      "type": "custom",
      "entity": "Post",
      "method": "POST",
      "path": "/posts/{id}/upvote",
      "auth": "jwt",
      "summary": "Upvote a post",
      "description": "Increments the post's upvoteCount by 1 for authenticated members."
    },
    {
      "operationId": "bookmark.list",
      "type": "crud",
      "action": "list",
      "entity": "Bookmark",
      "method": "GET",
      "path": "/bookmarks",
      "policy": "ownBookmarks",
      "pagination": true,
      "filters": [
        "postId"
      ],
      "sort": [
        "createdAt"
      ]
    },
    {
      "operationId": "bookmark.get",
      "type": "crud",
      "action": "get",
      "entity": "Bookmark",
      "method": "GET",
      "path": "/bookmarks/{id}",
      "policy": "ownBookmarks"
    },
    {
      "operationId": "bookmark.create",
      "type": "crud",
      "action": "create",
      "entity": "Bookmark",
      "method": "POST",
      "path": "/bookmarks",
      "auth": "jwt",
      "rules": [
        "singleBookmarkPerUser"
      ]
    },
    {
      "operationId": "bookmark.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Bookmark",
      "method": "DELETE",
      "path": "/bookmarks/{id}",
      "policy": "ownBookmarks"
    }
  ],
