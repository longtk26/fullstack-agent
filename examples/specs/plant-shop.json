{
  "specVersion": "1.0",
  "project": {
    "name": "Leafy Corner",
    "description": "An online plant shop where shoppers browse plants across collections, filter by size and light needs, add to cart, and track orders, while the shop owner manages inventory and order fulfillment."
  },
  "stack": {
    "framework": "fastapi",
    "database": "postgresql",
    "orm": "sqlmodel",
    "migration": "alembic"
  },
  "auth": {
    "type": "jwt",
    "roles": [
      "shopper",
      "owner"
    ]
  },
  "entities": [
    {
      "name": "Collection",
      "displayField": "name",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "unique": true,
          "maxLength": 80
        },
        {
          "name": "description",
          "type": "text",
          "maxLength": 500
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Plant",
      "displayField": "name",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "collectionId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "maxLength": 100
        },
        {
          "name": "photo",
          "type": "image",
          "required": true
        },
        {
          "name": "price",
          "type": "decimal",
          "required": true,
          "min": 0
        },
        {
          "name": "size",
          "type": "enum",
          "values": [
            "small",
            "medium",
            "large"
          ],
          "required": true
        },
        {
          "name": "lightNeed",
          "type": "enum",
          "values": [
            "low",
            "medium",
            "bright"
          ],
          "required": true
        },
        {
          "name": "petSafe",
          "type": "boolean",
          "required": true,
          "default": false
        },
        {
          "name": "stockCount",
          "type": "integer",
          "required": true,
          "min": 0,
          "default": 0
        },
        {
          "name": "careNote",
          "type": "text",
          "required": true,
          "maxLength": 1000
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "CartItem",
      "displayField": "id",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "ownerId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "plantId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "quantity",
          "type": "integer",
          "required": true,
          "min": 1,
          "default": 1
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Order",
      "displayField": "id",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "ownerId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "totalAmount",
          "type": "decimal",
          "required": true,
          "min": 0
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "paid",
            "packed",
            "shipped",
            "delivered"
          ],
          "default": "paid"
        },
        {
          "name": "paymentStatus",
          "type": "enum",
          "values": [
            "UNPAID",
            "PAID",
            "FAILED"
          ],
          "default": "PAID"
        },
        {
          "name": "shippingAddress",
          "type": "text",
          "required": true,
          "maxLength": 300
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "OrderItem",
      "displayField": "id",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "orderId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "plantId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "unitPrice",
          "type": "decimal",
          "required": true,
          "min": 0
        },
        {
          "name": "quantity",
          "type": "integer",
          "required": true,
          "min": 1
        }
      ]
    }
  ],
  "relationships": [
    {
      "name": "collectionPlants",
      "type": "one-to-many",
      "from": "Collection",
      "to": "Plant",
      "foreignKey": "collectionId",
      "onDelete": "RESTRICT"
    },
    {
      "name": "plantCartItems",
      "type": "one-to-many",
      "from": "Plant",
      "to": "CartItem",
      "foreignKey": "plantId",
      "onDelete": "CASCADE"
    },
    {
      "name": "orderItems",
      "type": "one-to-many",
      "from": "Order",
      "to": "OrderItem",
      "foreignKey": "orderId",
      "onDelete": "CASCADE"
    },
    {
      "name": "plantOrderItems",
      "type": "one-to-many",
      "from": "Plant",
      "to": "OrderItem",
      "foreignKey": "plantId",
      "onDelete": "RESTRICT"
    }
  ],
  "policies": [
    {
      "name": "ownerOnly",
      "type": "role",
      "roles": [
        "owner"
      ]
    },
    {
      "name": "ownCart",
      "type": "ownership",
      "ownerField": "ownerId"
    },
    {
      "name": "ownOrders",
      "type": "ownership",
      "ownerField": "ownerId",
      "bypassRoles": [
        "owner"
      ]
    }
  ],
  "rules": [
    {
      "id": "orderStatusFlow",
      "kind": "transition",
      "entity": "Order",
      "params": {
        "field": "status",
        "transitions": {
          "paid": [
            "packed"
          ],
          "packed": [
            "shipped"
          ],
          "shipped": [
            "delivered"
          ]
        }
      },
      "description": "Orders progress strictly from paid to packed, packed to shipped, and shipped to delivered."
    },
    {
      "id": "deliveredIsFinal",
      "kind": "immutableAfter",
      "entity": "Order",
      "params": {
        "field": "status",
        "states": [
          "delivered"
        ]
      },
      "description": "Delivered orders cannot be modified."
    }
  ],
  "payments": {
    "provider": "fake",
    "entity": "Order",
    "amountField": "totalAmount",
    "currency": "USD",
    "statusField": "paymentStatus",
    "paidStatus": "PAID",
    "failedStatus": "FAILED"
  },
  "operations": [
    {
      "operationId": "collection.list",
      "type": "crud",
      "action": "list",
      "entity": "Collection",
      "method": "GET",
      "path": "/collections",
      "pagination": true,
      "search": [
        "name"
      ],
      "sort": [
        "name"
      ]
    },
    {
      "operationId": "collection.get",
      "type": "crud",
      "action": "get",
      "entity": "Collection",
      "method": "GET",
      "path": "/collections/{id}"
    },
    {
      "operationId": "collection.create",
      "type": "crud",
      "action": "create",
      "entity": "Collection",
      "method": "POST",
      "path": "/collections",
      "policy": "ownerOnly"
    },
    {
      "operationId": "collection.update",
      "type": "crud",
      "action": "update",
      "entity": "Collection",
      "method": "PATCH",
      "path": "/collections/{id}",
      "policy": "ownerOnly"
    },
    {
      "operationId": "collection.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Collection",
      "method": "DELETE",
      "path": "/collections/{id}",
      "policy": "ownerOnly"
    },
    {
      "operationId": "plant.list",
      "type": "crud",
      "action": "list",
      "entity": "Plant",
      "method": "GET",
      "path": "/plants",
      "pagination": true,
      "filters": [
        "collectionId",
        "size",
        "lightNeed",
        "petSafe"
      ],
      "search": [
        "name"
      ],
      "sort": [
        "price",
        "name",
        "createdAt"
      ]
    },
    {
      "operationId": "plant.get",
      "type": "crud",
      "action": "get",
      "entity": "Plant",
      "method": "GET",
      "path": "/plants/{id}"
    },
    {
      "operationId": "plant.create",
      "type": "crud",
      "action": "create",
      "entity": "Plant",
      "method": "POST",
      "path": "/plants",
      "policy": "ownerOnly"
    },
    {
      "operationId": "plant.update",
      "type": "crud",
      "action": "update",
      "entity": "Plant",
      "method": "PATCH",
      "path": "/plants/{id}",
      "policy": "ownerOnly"
    },
    {
      "operationId": "plant.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Plant",
      "method": "DELETE",
      "path": "/plants/{id}",
      "policy": "ownerOnly"
    },
    {
      "operationId": "cartItem.list",
      "type": "crud",
      "action": "list",
      "entity": "CartItem",
      "method": "GET",
      "path": "/cart-items",
      "policy": "ownCart",
      "pagination": true,
      "sort": [
        "createdAt"
      ]
    },
    {
      "operationId": "cartItem.create",
      "type": "crud",
      "action": "create",
      "entity": "CartItem",
      "method": "POST",
      "path": "/cart-items",
      "auth": "jwt"
    },
    {
      "operationId": "cartItem.update",
      "type": "crud",
      "action": "update",
      "entity": "CartItem",
      "method": "PATCH",
      "path": "/cart-items/{id}",
      "policy": "ownCart"
    },
    {
      "operationId": "cartItem.delete",
      "type": "crud",
      "action": "delete",
      "entity": "CartItem",
      "method": "DELETE",
      "path": "/cart-items/{id}",
      "policy": "ownCart"
    },
    {
      "operationId": "order.list",
      "type": "crud",
      "action": "list",
      "entity": "Order",
      "method": "GET",
      "path": "/orders",
      "policy": "ownOrders",
      "pagination": true,
      "filters": [
        "status",
        "paymentStatus"
      ],
      "sort": [
        "createdAt"
      ]
    },
    {
      "operationId": "order.get",
      "type": "crud",
      "action": "get",
      "entity": "Order",
      "method": "GET",
      "path": "/orders/{id}",
      "policy": "ownOrders"
    },
    {
      "operationId": "order.checkout",
      "type": "custom",
      "method": "POST",
      "path": "/orders/checkout",
      "auth": "jwt",
      "description": "Takes a shipping address, creates an Order and OrderItems for the signed-in shopper from their active cart items, calculates total amount, reduces plant stock count, clears cart items, and initializes payment."
    },
    {
      "operationId": "order.update",
      "type": "crud",
      "action": "update",
      "entity": "Order",
      "method": "PATCH",
      "path": "/orders/{id}",
      "policy": "ownerOnly",
      "rules": [
        "orderStatusFlow",
        "deliveredIsFinal"
      ]
    },
    {
      "operationId": "orderItem.list",
      "type": "crud",
      "action": "list",
      "entity": "OrderItem",
      "method": "GET",
      "path": "/order-items",
      "auth": "jwt",
      "filters": [
        "orderId"
      ]
    },
    {
      "operationId": "plant.count",
      "type": "aggregate",
      "entity": "Plant",
      "method": "GET",
      "path": "/plants/aggregate/count",
      "summary": "Available plants",
      "aggregate": {
        "fn": "count"
      }
    },
    {
      "operationId": "order.countWhereStatusPaid",
      "type": "aggregate",
      "entity": "Order",
      "method": "GET",
      "path": "/orders/aggregate/count-where-status-paid",
      "summary": "Active orders to fulfill",
      "aggregate": {
        "fn": "count",
        "filters": {
          "status": "paid"
        }
      }
    },
    {
      "operationId": "order.countByStatus",
      "type": "aggregate",
      "entity": "Order",
      "method": "GET",
      "path": "/orders/aggregate/count-by-status",
      "summary": "Orders by status",
      "aggregate": {
        "fn": "count",
        "groupBy": "status"
      }
    },
    {
      "operationId": "plant.countByLightNeed",
      "type": "aggregate",
      "entity": "Plant",
      "method": "GET",
      "path": "/plants/aggregate/count-by-light-need",
      "summary": "Plants by light need",
      "aggregate": {
        "fn": "count",
        "groupBy": "lightNeed"
      }
    }
  ],
