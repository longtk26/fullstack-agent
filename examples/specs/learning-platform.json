{
  "specVersion": "1.0",
  "project": {
    "name": "Learnly",
    "description": "Online course platform for a small training company where managers publish courses and track revenue, and learners enrol and track their progress."
  },
  "stack": {
    "framework": "fastapi",
    "database": "postgresql",
    "orm": "sqlmodel",
    "migration": "alembic"
  },
  "auth": {
    "type": "jwt",
    "roles": [
      "learner",
      "manager"
    ]
  },
  "policies": [
    {
      "name": "managersOnly",
      "type": "role",
      "roles": [
        "manager"
      ]
    },
    {
      "name": "ownEnrolments",
      "type": "ownership",
      "ownerField": "learnerId",
      "bypassRoles": [
        "manager"
      ]
    },
    {
      "name": "ownCompletions",
      "type": "ownership",
      "ownerField": "learnerId",
      "bypassRoles": [
        "manager"
      ]
    }
  ],
  "rules": [
    {
      "id": "courseStatusTransitions",
      "kind": "transition",
      "entity": "Course",
      "params": {
        "field": "status",
        "transitions": {
          "draft": [
            "published"
          ],
          "published": [
            "draft"
          ]
        }
      },
      "description": "Courses can move between draft and published statuses."
    },
    {
      "id": "singleEnrolmentPerUserCourse",
      "kind": "uniqueTogether",
      "entity": "Enrolment",
      "params": {
        "fields": [
          "learnerId",
          "courseId"
        ]
      },
      "description": "A learner cannot enrol in the same course more than once."
    },
    {
      "id": "singleLessonCompletionPerEnrolment",
      "kind": "uniqueTogether",
      "entity": "LessonCompletion",
      "params": {
        "fields": [
          "enrolmentId",
          "lessonId"
        ]
      },
      "description": "A lesson can only be marked completed once per enrolment."
    }
  ],
  "payments": {
    "provider": "fake",
    "entity": "Enrolment",
    "amountField": "amount",
    "currency": "USD",
    "statusField": "paymentStatus",
    "paidStatus": "PAID",
    "failedStatus": "FAILED"
  },
  "entities": [
    {
      "name": "Course",
      "displayField": "title",
      "description": "Online courses created by managers across Design, Programming, and Marketing.",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "maxLength": 140
        },
        {
          "name": "coverImage",
          "type": "image",
          "required": false,
          "nullable": true
        },
        {
          "name": "level",
          "type": "enum",
          "values": [
            "beginner",
            "intermediate",
            "advanced"
          ],
          "required": true
        },
        {
          "name": "category",
          "type": "string",
          "required": true,
          "maxLength": 60,
          "index": true
        },
        {
          "name": "price",
          "type": "decimal",
          "required": true,
          "min": 0
        },
        {
          "name": "summary",
          "type": "text",
          "required": true,
          "maxLength": 1500
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "draft",
            "published"
          ],
          "required": true,
          "default": "draft",
          "index": true
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Lesson",
      "displayField": "title",
      "description": "Ordered video lessons belonging to a specific course.",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "courseId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "maxLength": 140
        },
        {
          "name": "durationMinutes",
          "type": "integer",
          "required": true,
          "min": 1,
          "max": 600
        },
        {
          "name": "videoUrl",
          "type": "string",
          "required": true,
          "maxLength": 500
        },
        {
          "name": "orderIndex",
          "type": "integer",
          "required": true,
          "min": 1
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Enrolment",
      "displayField": "courseTitle",
      "description": "A learner's enrolment in a published course with tracked progress.",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "courseId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "courseTitle",
          "type": "string",
          "required": true,
          "maxLength": 140
        },
        {
          "name": "category",
          "type": "string",
          "required": true,
          "maxLength": 60,
          "index": true
        },
        {
          "name": "learnerId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "learnerName",
          "type": "string",
          "required": true,
          "maxLength": 120
        },
        {
          "name": "amount",
          "type": "decimal",
          "required": true,
          "min": 0
        },
        {
          "name": "paymentStatus",
          "type": "enum",
          "values": [
            "UNPAID",
            "PAID",
            "FAILED"
          ],
          "required": true,
          "default": "PAID"
        },
        {
          "name": "progressPercent",
          "type": "integer",
          "required": true,
          "default": 0,
          "min": 0,
          "max": 100
        },
        {
          "name": "enrolledAt",
          "type": "datetime",
          "required": true,
          "default": "now",
          "index": true
        }
      ]
    },
    {
      "name": "LessonCompletion",
      "displayField": "id",
      "description": "Completion markers for lessons marked as done by learners.",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "enrolmentId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "lessonId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "learnerId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "completedAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    }
  ],
  "relationships": [
    {
      "name": "courseLessons",
      "type": "one-to-many",
      "from": "Course",
      "to": "Lesson",
      "foreignKey": "courseId",
      "onDelete": "CASCADE"
    },
    {
      "name": "courseEnrolments",
      "type": "one-to-many",
      "from": "Course",
      "to": "Enrolment",
      "foreignKey": "courseId",
      "onDelete": "RESTRICT"
    },
    {
      "name": "enrolmentCompletions",
      "type": "one-to-many",
      "from": "Enrolment",
      "to": "LessonCompletion",
      "foreignKey": "enrolmentId",
      "onDelete": "CASCADE"
    },
    {
      "name": "lessonCompletions",
      "type": "one-to-many",
      "from": "Lesson",
      "to": "LessonCompletion",
      "foreignKey": "lessonId",
      "onDelete": "CASCADE"
    }
  ],
  "operations": [
    {
      "operationId": "course.create",
      "type": "crud",
      "action": "create",
      "entity": "Course",
      "method": "POST",
      "path": "/courses",
      "policy": "managersOnly"
    },
    {
      "operationId": "course.get",
      "type": "crud",
      "action": "get",
      "entity": "Course",
      "method": "GET",
      "path": "/courses/{id}"
    },
    {
      "operationId": "course.list",
      "type": "crud",
      "action": "list",
      "entity": "Course",
      "method": "GET",
      "path": "/courses",
      "pagination": true,
      "filters": [
        "status",
        "level",
        "category"
      ],
      "search": [
        "title",
        "summary"
      ],
      "sort": [
        "createdAt",
        "price",
        "title"
      ]
    },
    {
      "operationId": "course.update",
      "type": "crud",
      "action": "update",
      "entity": "Course",
      "method": "PATCH",
      "path": "/courses/{id}",
      "policy": "managersOnly",
      "rules": [
        "courseStatusTransitions"
      ]
    },
    {
      "operationId": "course.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Course",
      "method": "DELETE",
      "path": "/courses/{id}",
      "policy": "managersOnly"
    },
    {
      "operationId": "course.publish",
      "type": "custom",
      "method": "POST",
      "path": "/courses/{id}/publish",
      "policy": "managersOnly",
      "description": "Sets the course status to published, making it visible for learners to browse and enrol.",
      "response": {
        "entity": "Course"
      }
    },
    {
      "operationId": "course.unpublish",
      "type": "custom",
      "method": "POST",
      "path": "/courses/{id}/unpublish",
      "policy": "managersOnly",
      "description": "Sets the course status back to draft, hiding it from public enrolment.",
      "response": {
        "entity": "Course"
      }
    },
    {
      "operationId": "lesson.create",
      "type": "crud",
      "action": "create",
      "entity": "Lesson",
      "method": "POST",
      "path": "/lessons",
      "policy": "managersOnly"
    },
    {
      "operationId": "lesson.get",
      "type": "crud",
      "action": "get",
      "entity": "Lesson",
      "method": "GET",
      "path": "/lessons/{id}",
      "auth": "jwt"
    },
    {
      "operationId": "lesson.list",
      "type": "crud",
      "action": "list",
      "entity": "Lesson",
      "method": "GET",
      "path": "/lessons",
      "auth": "jwt",
      "pagination": true,
      "filters": [
        "courseId"
      ],
      "sort": [
        "orderIndex",
        "title"
      ],
      "search": [
        "title"
      ]
    },
    {
      "operationId": "lesson.update",
      "type": "crud",
      "action": "update",
      "entity": "Lesson",
      "method": "PATCH",
      "path": "/lessons/{id}",
      "policy": "managersOnly"
    },
    {
      "operationId": "lesson.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Lesson",
      "method": "DELETE",
      "path": "/lessons/{id}",
      "policy": "managersOnly"
    },
    {
      "operationId": "enrolment.create",
      "type": "crud",
      "action": "create",
      "entity": "Enrolment",
      "method": "POST",
      "path": "/enrolments",
      "auth": "jwt",
      "rules": [
        "singleEnrolmentPerUserCourse"
      ]
    },
    {
      "operationId": "enrolment.get",
      "type": "crud",
      "action": "get",
      "entity": "Enrolment",
      "method": "GET",
      "path": "/enrolments/{id}",
      "policy": "ownEnrolments"
    },
    {
      "operationId": "enrolment.list",
      "type": "crud",
      "action": "list",
      "entity": "Enrolment",
      "method": "GET",
      "path": "/enrolments",
      "policy": "ownEnrolments",
      "pagination": true,
      "filters": [
        "courseId",
        "learnerId",
        "paymentStatus",
        "category"
      ],
      "sort": [
        "enrolledAt",
        "progressPercent"
      ]
    },
    {
      "operationId": "enrolment.update",
      "type": "crud",
      "action": "update",
      "entity": "Enrolment",
      "method": "PATCH",
      "path": "/enrolments/{id}",
      "policy": "ownEnrolments"
    },
    {
      "operationId": "enrolment.markLessonDone",
      "type": "custom",
      "method": "POST",
      "path": "/enrolments/{id}/complete-lesson",
      "policy": "ownEnrolments",
      "description": "Accepts lessonId in body. Creates a LessonCompletion record if not already completed, calculates new progress percent as (completed lessons / total course lessons) * 100, updates enrolment.progressPercent, and returns the updated Enrolment.",
      "response": {
        "entity": "Enrolment"
      }
    },
    {
      "operationId": "lessonCompletion.list",
      "type": "crud",
      "action": "list",
      "entity": "LessonCompletion",
      "method": "GET",
      "path": "/lesson-completions",
      "policy": "ownCompletions",
      "pagination": true,
      "filters": [
        "enrolmentId",
        "lessonId",
        "learnerId"
      ]
    },
    {
      "operationId": "lessonCompletion.delete",
      "type": "crud",
      "action": "delete",
      "entity": "LessonCompletion",
      "method": "DELETE",
      "path": "/lesson-completions/{id}",
      "policy": "ownCompletions"
    },
    {
      "operationId": "dashboard.enrolmentsThisMonth",
      "type": "aggregate",
      "entity": "Enrolment",
      "method": "GET",
      "path": "/enrolments/aggregate/this-month",
      "policy": "managersOnly",
      "aggregate": {
        "fn": "count",
        "period": "month",
        "dateField": "enrolledAt"
      }
    },
    {
      "operationId": "dashboard.revenuePerCourse",
      "type": "aggregate",
      "entity": "Enrolment",
      "method": "GET",
      "path": "/enrolments/aggregate/revenue-per-course",
      "policy": "managersOnly",
      "aggregate": {
        "fn": "sum",
        "field": "amount",
        "groupBy": "courseTitle"
      }
    },
    {
      "operationId": "dashboard.popularCategories",
      "type": "aggregate",
      "entity": "Enrolment",
      "method": "GET",
      "path": "/enrolments/aggregate/popular-categories",
      "policy": "managersOnly",
      "aggregate": {
        "fn": "count",
        "groupBy": "category"
      }
    },
    {
      "operationId": "course.countWhereStatusPublished",
      "type": "aggregate",
      "entity": "Course",
      "method": "GET",
      "path": "/courses/aggregate/count-where-status-published",
      "summary": "Published courses",
      "aggregate": {
        "fn": "count",
        "filters": {
          "status": "published"
        }
      }
    }
  ],
