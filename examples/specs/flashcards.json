{
  "specVersion": "1.0",
  "project": {
    "name": "Flashcards",
    "description": "Spaced-repetition vocabulary learning app with decks, cards and SM-2 reviews"
  },
  "stack": {
    "framework": "fastapi",
    "database": "postgresql",
    "orm": "sqlalchemy",
    "migration": "alembic"
  },
  "entities": [
    {
      "name": "Deck",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true },
        { "name": "name", "type": "string", "required": true, "maxLength": 120 },
        { "name": "description", "type": "text" },
        { "name": "createdAt", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "Card",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true },
        { "name": "deckId", "type": "uuid", "required": true, "index": true },
        { "name": "front", "type": "string", "required": true, "maxLength": 500 },
        { "name": "back", "type": "string", "required": true, "maxLength": 500 },
        { "name": "example", "type": "text" },
        { "name": "intervalDays", "type": "integer", "required": true, "default": 0, "min": 0 },
        { "name": "ease", "type": "decimal", "required": true, "default": 2.5, "min": 1.3 },
        { "name": "dueDate", "type": "date", "required": true },
        { "name": "repetitionCount", "type": "integer", "required": true, "default": 0, "min": 0 },
        { "name": "createdAt", "type": "datetime", "required": true, "default": "now" }
      ]
    },
    {
      "name": "ReviewLog",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true },
        { "name": "cardId", "type": "uuid", "required": true, "index": true },
        { "name": "rating", "type": "string", "required": true, "maxLength": 10 },
        { "name": "intervalDays", "type": "integer", "required": true, "min": 0 },
        { "name": "ease", "type": "decimal", "required": true },
        { "name": "reviewedAt", "type": "datetime", "required": true, "default": "now" }
      ]
    }
  ],
  "relationships": [
    { "name": "deckCards", "type": "one-to-many", "from": "Deck", "to": "Card", "onDelete": "CASCADE" },
    { "name": "cardReviewLogs", "type": "one-to-many", "from": "Card", "to": "ReviewLog", "onDelete": "CASCADE" }
  ],
  "operations": [
    { "operationId": "deck.list", "type": "crud", "action": "list", "entity": "Deck", "method": "GET", "path": "/decks", "pagination": true, "sort": ["name", "createdAt"] },
    { "operationId": "deck.get", "type": "crud", "action": "get", "entity": "Deck", "method": "GET", "path": "/decks/{id}" },
    { "operationId": "deck.create", "type": "crud", "action": "create", "entity": "Deck", "method": "POST", "path": "/decks" },
    { "operationId": "deck.update", "type": "crud", "action": "update", "entity": "Deck", "method": "PATCH", "path": "/decks/{id}" },
    { "operationId": "deck.delete", "type": "crud", "action": "delete", "entity": "Deck", "method": "DELETE", "path": "/decks/{id}" },
    { "operationId": "card.list", "type": "crud", "action": "list", "entity": "Card", "method": "GET", "path": "/cards", "pagination": true, "filters": ["deckId"], "sort": ["dueDate", "createdAt"], "search": ["front", "back"] },
    { "operationId": "card.get", "type": "crud", "action": "get", "entity": "Card", "method": "GET", "path": "/cards/{id}" },
    { "operationId": "card.create", "type": "crud", "action": "create", "entity": "Card", "method": "POST", "path": "/cards" },
    { "operationId": "card.update", "type": "crud", "action": "update", "entity": "Card", "method": "PATCH", "path": "/cards/{id}" },
    { "operationId": "card.delete", "type": "crud", "action": "delete", "entity": "Card", "method": "DELETE", "path": "/cards/{id}" },
    { "operationId": "reviewLog.list", "type": "crud", "action": "list", "entity": "ReviewLog", "method": "GET", "path": "/review-logs", "pagination": true, "filters": ["cardId"], "sort": ["reviewedAt"] },
    { "operationId": "reviewLog.create", "type": "crud", "action": "create", "entity": "ReviewLog", "method": "POST", "path": "/review-logs" },
    {
      "operationId": "card.listDue",
      "type": "custom",
      "entity": "Card",
      "method": "GET",
      "path": "/cards/due",
      "filters": ["deckId"],
      "response": { "entity": "Card" },
      "description": "List cards due on or before today, optionally filtered by deckId."
    },
    {
      "operationId": "card.review",
      "type": "custom",
      "entity": "Card",
      "method": "POST",
      "path": "/cards/{id}/review",
      "request": {
        "properties": [
          { "name": "rating", "type": "enum", "values": ["again", "hard", "good", "easy"], "required": true }
        ]
      },
      "response": { "entity": "Card" },
      "description": "Submit a review rating for a card ('again', 'hard', 'good', or 'easy') using the SM-2 algorithm. If 'again', repetitionCount is reset to 0, intervalDays is set to 1, and ease is decreased by 0.2 (min 1.3). If 'hard', intervalDays is multiplied by 1.2, repetitionCount is incremented, and ease is decreased by 0.15 (min 1.3). If 'good', intervalDays is 1 on repetition 0, 6 on repetition 1, or intervalDays * ease, and repetitionCount is incremented. If 'easy', intervalDays is 1 on repetition 0, 6 on repetition 1, or intervalDays * ease * 1.3, repetitionCount is incremented, and ease is increased by 0.15. dueDate is updated to today + intervalDays. Creates a ReviewLog and returns the updated Card."
    },
    {
      "operationId": "deck.stats",
      "type": "custom",
      "entity": "Deck",
      "method": "GET",
      "path": "/decks/{id}/stats",
      "response": {
        "properties": [
          { "name": "total", "type": "integer" },
          { "name": "dueToday", "type": "integer" },
          { "name": "learned", "type": "integer" }
        ]
      },
      "description": "Get deck study statistics: total card count, number of cards due today or earlier, and number of learned cards (repetitionCount > 0)."
    }
  ],
  "seed": [
