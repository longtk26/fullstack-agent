{
  "specVersion": "1.0",
  "project": {
    "name": "Gather",
    "description": "Event ticketing platform for independent city venues connecting attendees with concerts, workshops, talks, and markets."
  },
  "stack": {
    "framework": "fastapi",
    "database": "postgresql",
    "orm": "sqlmodel",
    "migration": "alembic"
  },
  "auth": {
    "type": "jwt",
    "roles": [
      "attendee",
      "organizer"
    ]
  },
  "entities": [
    {
      "name": "Venue",
      "displayField": "name",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "maxLength": 120
        },
        {
          "name": "neighborhood",
          "type": "string",
          "required": true,
          "maxLength": 100
        },
        {
          "name": "address",
          "type": "string",
          "required": true,
          "maxLength": 200
        },
        {
          "name": "capacity",
          "type": "integer",
          "required": true,
          "min": 1,
          "max": 5000
        },
        {
          "name": "description",
          "type": "text",
          "maxLength": 1000
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Event",
      "displayField": "title",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "maxLength": 150
        },
        {
          "name": "category",
          "type": "enum",
          "values": [
            "CONCERT",
            "WORKSHOP",
            "TALK",
            "MARKET"
          ],
          "required": true,
          "index": true
        },
        {
          "name": "poster",
          "type": "image",
          "required": false,
          "nullable": true
        },
        {
          "name": "venueId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "startTime",
          "type": "datetime",
          "required": true,
          "index": true
        },
        {
          "name": "price",
          "type": "decimal",
          "required": true,
          "min": 0
        },
        {
          "name": "capacity",
          "type": "integer",
          "required": true,
          "min": 1,
          "max": 5000
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "DRAFT",
            "PUBLISHED",
            "CANCELLED"
          ],
          "required": true,
          "default": "DRAFT",
          "index": true
        },
        {
          "name": "description",
          "type": "text",
          "maxLength": 3000
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Ticket",
      "displayField": "qrCodeRef",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "eventId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "attendeeId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "attendeeName",
          "type": "string",
          "required": true,
          "maxLength": 120
        },
        {
          "name": "pricePaid",
          "type": "decimal",
          "required": true,
          "min": 0
        },
        {
          "name": "qrCodeRef",
          "type": "string",
          "required": true,
          "unique": true,
          "maxLength": 32
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "VALID",
            "CHECKED_IN",
            "CANCELLED"
          ],
          "required": true,
          "default": "VALID",
          "index": true
        },
        {
          "name": "paymentStatus",
          "type": "enum",
          "values": [
            "UNPAID",
            "PAID",
            "FAILED"
          ],
          "required": true,
          "default": "PAID"
        },
        {
          "name": "checkedInAt",
          "type": "datetime",
          "required": false,
          "nullable": true
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    }
  ],
  "relationships": [
    {
      "name": "venueEvents",
      "type": "one-to-many",
      "from": "Venue",
      "to": "Event",
      "foreignKey": "venueId",
      "onDelete": "RESTRICT"
    },
    {
      "name": "eventTickets",
      "type": "one-to-many",
      "from": "Event",
      "to": "Ticket",
      "foreignKey": "eventId",
      "onDelete": "CASCADE"
    }
  ],
  "policies": [
    {
      "name": "organizersOnly",
      "type": "role",
      "roles": [
        "organizer"
      ]
    },
    {
      "name": "ownTickets",
      "type": "ownership",
      "ownerField": "attendeeId",
      "bypassRoles": [
        "organizer"
      ]
    }
  ],
  "rules": [
    {
      "id": "eventStatusFlow",
      "kind": "transition",
      "entity": "Event",
      "params": {
        "field": "status",
        "transitions": {
          "DRAFT": [
            "PUBLISHED",
            "CANCELLED"
          ],
          "PUBLISHED": [
            "CANCELLED"
          ]
        }
      }
    },
    {
      "id": "eventCancelledFinal",
      "kind": "immutableAfter",
      "entity": "Event",
      "params": {
        "field": "status",
        "states": [
          "CANCELLED"
        ]
      }
    },
    {
      "id": "ticketStatusFlow",
      "kind": "transition",
      "entity": "Ticket",
      "params": {
        "field": "status",
        "transitions": {
          "VALID": [
            "CHECKED_IN",
            "CANCELLED"
          ],
          "CHECKED_IN": []
        }
      }
    },
    {
      "id": "ticketCapacityLimit",
      "kind": "capacity",
      "entity": "Ticket",
      "params": {
        "parent": "eventId",
        "capacityField": "capacity",
        "where": {
          "status": {
            "ne": "CANCELLED"
          }
        }
      }
    }
  ],
  "payments": {
    "provider": "fake",
    "entity": "Ticket",
    "amountField": "pricePaid",
    "currency": "USD",
    "statusField": "paymentStatus",
    "paidStatus": "PAID",
    "failedStatus": "FAILED"
  },
  "operations": [
    {
      "operationId": "venue.create",
      "type": "crud",
      "action": "create",
      "entity": "Venue",
      "method": "POST",
      "path": "/venues",
      "policy": "organizersOnly"
    },
    {
      "operationId": "venue.get",
      "type": "crud",
      "action": "get",
      "entity": "Venue",
      "method": "GET",
      "path": "/venues/{id}"
    },
    {
      "operationId": "venue.list",
      "type": "crud",
      "action": "list",
      "entity": "Venue",
      "method": "GET",
      "path": "/venues",
      "pagination": true,
      "search": [
        "name",
        "neighborhood"
      ],
      "sort": [
        "name"
      ]
    },
    {
      "operationId": "venue.update",
      "type": "crud",
      "action": "update",
      "entity": "Venue",
      "method": "PATCH",
      "path": "/venues/{id}",
      "policy": "organizersOnly"
    },
    {
      "operationId": "venue.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Venue",
      "method": "DELETE",
      "path": "/venues/{id}",
      "policy": "organizersOnly"
    },
    {
      "operationId": "event.create",
      "type": "crud",
      "action": "create",
      "entity": "Event",
      "method": "POST",
      "path": "/events",
      "policy": "organizersOnly"
    },
    {
      "operationId": "event.get",
      "type": "crud",
      "action": "get",
      "entity": "Event",
      "method": "GET",
      "path": "/events/{id}"
    },
    {
      "operationId": "event.list",
      "type": "crud",
      "action": "list",
      "entity": "Event",
      "method": "GET",
      "path": "/events",
      "pagination": true,
      "filters": [
        "category",
        "venueId",
        "status"
      ],
      "search": [
        "title"
      ],
      "sort": [
        "startTime",
        "price",
        "createdAt"
      ]
    },
    {
      "operationId": "event.update",
      "type": "crud",
      "action": "update",
      "entity": "Event",
      "method": "PATCH",
      "path": "/events/{id}",
      "policy": "organizersOnly",
      "rules": [
        "eventStatusFlow",
        "eventCancelledFinal"
      ]
    },
    {
      "operationId": "event.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Event",
      "method": "DELETE",
      "path": "/events/{id}",
      "policy": "organizersOnly",
      "rules": [
        "eventCancelledFinal"
      ]
    },
    {
      "operationId": "ticket.create",
      "type": "crud",
      "action": "create",
      "entity": "Ticket",
      "method": "POST",
      "path": "/tickets",
      "auth": "jwt",
      "rules": [
        "ticketCapacityLimit"
      ]
    },
    {
      "operationId": "ticket.get",
      "type": "crud",
      "action": "get",
      "entity": "Ticket",
      "method": "GET",
      "path": "/tickets/{id}",
      "policy": "ownTickets"
    },
    {
      "operationId": "ticket.list",
      "type": "crud",
      "action": "list",
      "entity": "Ticket",
      "method": "GET",
      "path": "/tickets",
      "policy": "ownTickets",
      "pagination": true,
      "filters": [
        "eventId",
        "status",
        "attendeeId"
      ],
      "sort": [
        "createdAt"
      ]
    },
    {
      "operationId": "ticket.update",
      "type": "crud",
      "action": "update",
      "entity": "Ticket",
      "method": "PATCH",
      "path": "/tickets/{id}",
      "policy": "organizersOnly",
      "rules": [
        "ticketStatusFlow"
      ]
    },
    {
      "operationId": "ticket.checkIn",
      "type": "custom",
      "method": "POST",
      "path": "/tickets/{id}/check-in",
      "policy": "organizersOnly",
      "summary": "Check in ticket",
      "description": "Validates the QR code reference and marks a valid ticket as CHECKED_IN, setting checkedInAt to the current timestamp. Returns 400 if already checked in or cancelled."
    },
    {
      "operationId": "organizer.ticketsThisWeek",
      "type": "aggregate",
      "entity": "Ticket",
      "method": "GET",
      "path": "/organizer/analytics/tickets-this-week",
      "policy": "organizersOnly",
      "aggregate": {
        "fn": "count",
        "period": "week",
        "dateField": "createdAt",
        "filters": {
          "paymentStatus": "PAID"
        }
      }
    },
    {
      "operationId": "organizer.revenuePerEvent",
      "type": "aggregate",
      "entity": "Ticket",
      "method": "GET",
      "path": "/organizer/analytics/revenue-per-event",
      "policy": "organizersOnly",
      "aggregate": {
        "fn": "sum",
        "field": "pricePaid",
        "groupBy": "eventId",
        "filters": {
          "paymentStatus": "PAID"
        }
      }
    },
    {
      "operationId": "ticket.countThisWeek",
      "type": "aggregate",
      "entity": "Ticket",
      "method": "GET",
      "path": "/tickets/aggregate/count-this-week",
      "summary": "Tickets Sold This Week",
      "aggregate": {
        "fn": "count",
        "period": "week",
        "dateField": "createdAt"
      }
    },
    {
      "operationId": "ticket.sumPricePaidByEventId",
      "type": "aggregate",
      "entity": "Ticket",
      "method": "GET",
      "path": "/tickets/aggregate/sum-price-paid-by-event-id",
      "summary": "Revenue per Event",
      "aggregate": {
        "fn": "sum",
        "field": "pricePaid",
        "groupBy": "eventId"
      }
    },
    {
      "operationId": "event.countWhereStatusPublished",
      "type": "aggregate",
      "entity": "Event",
      "method": "GET",
      "path": "/events/aggregate/count-where-status-published",
      "summary": "Upcoming Events",
      "aggregate": {
        "fn": "count",
        "filters": {
          "status": "PUBLISHED"
        }
      }
    },
    {
      "operationId": "ticket.countByStatus",
      "type": "aggregate",
      "entity": "Ticket",
      "method": "GET",
      "path": "/tickets/aggregate/count-by-status",
      "summary": "Tickets by Status",
      "aggregate": {
        "fn": "count",
        "groupBy": "status"
      }
    }
  ],
