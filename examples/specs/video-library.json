{
  "specVersion": "1.0",
  "project": {
    "name": "StudioTube",
    "description": "Internal video library for company training, product demonstrations, and team channels",
    "slug": "studiotube"
  },
  "stack": {
    "framework": "fastapi",
    "database": "postgresql",
    "orm": "sqlmodel",
    "migration": "alembic"
  },
  "auth": {
    "type": "jwt",
    "roles": [
      "viewer",
      "creator"
    ]
  },
  "entities": [
    {
      "name": "Channel",
      "description": "Organizational unit or team channel hosting training and product videos",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "unique": true,
          "maxLength": 100
        },
        {
          "name": "slug",
          "type": "string",
          "required": true,
          "unique": true,
          "maxLength": 100
        },
        {
          "name": "shortDescription",
          "type": "string",
          "required": true,
          "maxLength": 300
        },
        {
          "name": "bannerImage",
          "type": "image",
          "required": false,
          "nullable": true
        },
        {
          "name": "subscriberCount",
          "type": "integer",
          "required": true,
          "default": 0,
          "min": 0
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Video",
      "description": "Video upload containing metadata, playback duration, views, and channel association",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "channelId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "maxLength": 150
        },
        {
          "name": "description",
          "type": "text",
          "required": true,
          "maxLength": 4000
        },
        {
          "name": "thumbnail",
          "type": "image",
          "required": false,
          "nullable": true
        },
        {
          "name": "duration",
          "type": "integer",
          "required": true,
          "min": 1,
          "description": "Duration in seconds"
        },
        {
          "name": "category",
          "type": "enum",
          "values": [
            "TRAINING",
            "PRODUCT",
            "WALKTHROUGH",
            "ONBOARDING",
            "ALL_HANDS"
          ],
          "required": true,
          "index": true
        },
        {
          "name": "viewCount",
          "type": "integer",
          "required": true,
          "default": 0,
          "min": 0
        },
        {
          "name": "publishDate",
          "type": "datetime",
          "required": true,
          "default": "now"
        },
        {
          "name": "videoUrl",
          "type": "string",
          "required": false,
          "nullable": true,
          "description": "URL or stream source"
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Playlist",
      "description": "Personal viewer playlist grouping videos for quick access and study tracks",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "ownerId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "maxLength": 120
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "nullable": true,
          "maxLength": 500
        },
        {
          "name": "isPrivate",
          "type": "boolean",
          "required": true,
          "default": true
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "PlaylistItem",
      "description": "Association joining a video to a specific playlist with an ordering position",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "playlistId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "videoId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "ownerId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "position",
          "type": "integer",
          "required": true,
          "default": 1
        },
        {
          "name": "addedAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    }
  ],
  "relationships": [
    {
      "name": "channelVideos",
      "type": "one-to-many",
      "from": "Channel",
      "to": "Video",
      "foreignKey": "channelId",
      "onDelete": "CASCADE"
    },
    {
      "name": "playlistItems",
      "type": "one-to-many",
      "from": "Playlist",
      "to": "PlaylistItem",
      "foreignKey": "playlistId",
      "onDelete": "CASCADE"
    },
    {
      "name": "videoPlaylistItems",
      "type": "one-to-many",
      "from": "Video",
      "to": "PlaylistItem",
      "foreignKey": "videoId",
      "onDelete": "CASCADE"
    }
  ],
  "policies": [
    {
      "name": "creatorsOnly",
      "type": "role",
      "roles": [
        "creator"
      ]
    },
    {
      "name": "ownPlaylists",
      "type": "ownership",
      "ownerField": "ownerId",
      "bypassRoles": [
        "creator"
      ]
    }
  ],
  "rules": [
    {
      "id": "uniqueVideoInPlaylist",
      "kind": "uniqueTogether",
      "entity": "PlaylistItem",
      "params": {
        "fields": [
          "playlistId",
          "videoId"
        ]
      },
      "description": "A video can only be added once to a given playlist"
    }
  ],
  "operations": [
    {
      "operationId": "channel.list",
      "type": "crud",
      "action": "list",
      "entity": "Channel",
      "method": "GET",
      "path": "/channels",
      "pagination": true,
      "sort": [
        "name",
        "subscriberCount",
        "createdAt"
      ],
      "search": [
        "name",
        "shortDescription"
      ]
    },
    {
      "operationId": "channel.get",
      "type": "crud",
      "action": "get",
      "entity": "Channel",
      "method": "GET",
      "path": "/channels/{id}"
    },
    {
      "operationId": "channel.create",
      "type": "crud",
      "action": "create",
      "entity": "Channel",
      "method": "POST",
      "path": "/channels",
      "policy": "creatorsOnly"
    },
    {
      "operationId": "channel.update",
      "type": "crud",
      "action": "update",
      "entity": "Channel",
      "method": "PATCH",
      "path": "/channels/{id}",
      "policy": "creatorsOnly"
    },
    {
      "operationId": "video.list",
      "type": "crud",
      "action": "list",
      "entity": "Video",
      "method": "GET",
      "path": "/videos",
      "pagination": true,
      "filters": [
        "channelId",
        "category"
      ],
      "sort": [
        "publishDate",
        "viewCount",
        "title",
        "duration"
      ],
      "search": [
        "title",
        "description"
      ]
    },
    {
      "operationId": "video.get",
      "type": "crud",
      "action": "get",
      "entity": "Video",
      "method": "GET",
      "path": "/videos/{id}"
    },
    {
      "operationId": "video.create",
      "type": "crud",
      "action": "create",
      "entity": "Video",
      "method": "POST",
      "path": "/videos",
      "policy": "creatorsOnly"
    },
    {
      "operationId": "video.update",
      "type": "crud",
      "action": "update",
      "entity": "Video",
      "method": "PATCH",
      "path": "/videos/{id}",
      "policy": "creatorsOnly"
    },
    {
      "operationId": "video.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Video",
      "method": "DELETE",
      "path": "/videos/{id}",
      "policy": "creatorsOnly"
    },
    {
      "operationId": "video.recordView",
      "type": "custom",
      "method": "POST",
      "path": "/videos/{id}/view",
      "description": "Increments the view count of the specified video by 1 upon playback and returns the updated count",
      "auth": "none"
    },
    {
      "operationId": "playlist.list",
      "type": "crud",
      "action": "list",
      "entity": "Playlist",
      "method": "GET",
      "path": "/playlists",
      "policy": "ownPlaylists",
      "pagination": true,
      "sort": [
        "createdAt",
        "title"
      ],
      "search": [
        "title"
      ]
    },
    {
      "operationId": "playlist.get",
      "type": "crud",
      "action": "get",
      "entity": "Playlist",
      "method": "GET",
      "path": "/playlists/{id}",
      "policy": "ownPlaylists"
    },
    {
      "operationId": "playlist.create",
      "type": "crud",
      "action": "create",
      "entity": "Playlist",
      "method": "POST",
      "path": "/playlists",
      "auth": "jwt"
    },
    {
      "operationId": "playlist.update",
      "type": "crud",
      "action": "update",
      "entity": "Playlist",
      "method": "PATCH",
      "path": "/playlists/{id}",
      "policy": "ownPlaylists"
    },
    {
      "operationId": "playlist.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Playlist",
      "method": "DELETE",
      "path": "/playlists/{id}",
      "policy": "ownPlaylists"
    },
    {
      "operationId": "playlistItem.list",
      "type": "crud",
      "action": "list",
      "entity": "PlaylistItem",
      "method": "GET",
      "path": "/playlist-items",
      "policy": "ownPlaylists",
      "pagination": true,
      "filters": [
        "playlistId",
        "videoId"
      ],
      "sort": [
        "position",
        "addedAt"
      ]
    },
    {
      "operationId": "playlistItem.create",
      "type": "crud",
      "action": "create",
      "entity": "PlaylistItem",
      "method": "POST",
      "path": "/playlist-items",
      "auth": "jwt",
      "rules": [
        "uniqueVideoInPlaylist"
      ]
    },
    {
      "operationId": "playlistItem.delete",
      "type": "crud",
      "action": "delete",
      "entity": "PlaylistItem",
      "method": "DELETE",
      "path": "/playlist-items/{id}",
      "policy": "ownPlaylists"
    },
    {
      "operationId": "video.count",
      "type": "aggregate",
      "entity": "Video",
      "method": "GET",
      "path": "/videos/aggregate/count",
      "summary": "Total Videos",
      "aggregate": {
        "fn": "count"
      }
    },
    {
      "operationId": "video.sumViewCount",
      "type": "aggregate",
      "entity": "Video",
      "method": "GET",
      "path": "/videos/aggregate/sum-view-count",
      "summary": "Total Views",
      "aggregate": {
        "fn": "sum",
        "field": "viewCount"
      }
    },
    {
      "operationId": "channel.count",
      "type": "aggregate",
      "entity": "Channel",
      "method": "GET",
      "path": "/channels/aggregate/count",
      "summary": "Active Channels",
      "aggregate": {
        "fn": "count"
      }
    },
    {
      "operationId": "video.countByCategory",
      "type": "aggregate",
      "entity": "Video",
      "method": "GET",
      "path": "/videos/aggregate/count-by-category",
      "summary": "Videos by Category",
      "aggregate": {
        "fn": "count",
        "groupBy": "category"
      }
    }
  ],
