{
  "specVersion": "1.0",
  "project": {
    "name": "Bright Smile Clinic",
    "description": "Appointment booking system for a dental clinic with dentists, treatments, schedule conflict prevention, and front desk workflow.",
    "slug": "bright-smile-clinic"
  },
  "stack": {
    "framework": "fastapi",
    "database": "postgresql",
    "orm": "sqlmodel",
    "migration": "alembic"
  },
  "auth": {
    "type": "jwt",
    "roles": [
      "patient",
      "front_desk"
    ]
  },
  "entities": [
    {
      "name": "Dentist",
      "displayField": "name",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "maxLength": 100
        },
        {
          "name": "specialty",
          "type": "string",
          "required": true,
          "maxLength": 120
        },
        {
          "name": "photo",
          "type": "image",
          "required": false,
          "nullable": true
        },
        {
          "name": "bio",
          "type": "text",
          "required": false,
          "nullable": true,
          "maxLength": 1000
        },
        {
          "name": "email",
          "type": "string",
          "required": false,
          "nullable": true,
          "maxLength": 120
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Treatment",
      "displayField": "name",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "maxLength": 80
        },
        {
          "name": "description",
          "type": "text",
          "required": false,
          "nullable": true,
          "maxLength": 1000
        },
        {
          "name": "durationMinutes",
          "type": "integer",
          "required": true,
          "min": 10,
          "max": 240
        },
        {
          "name": "price",
          "type": "decimal",
          "required": true,
          "min": 0
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ]
    },
    {
      "name": "Appointment",
      "displayField": "startAt",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "primary": true
        },
        {
          "name": "patientId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "dentistId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "treatmentId",
          "type": "uuid",
          "required": true,
          "index": true
        },
        {
          "name": "startAt",
          "type": "datetime",
          "required": true,
          "index": true
        },
        {
          "name": "endAt",
          "type": "datetime",
          "required": true
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "REQUESTED",
            "CONFIRMED",
            "CANCELLED",
            "COMPLETED"
          ],
          "default": "REQUESTED",
          "required": true
        },
        {
          "name": "notes",
          "type": "text",
          "required": false,
          "nullable": true,
          "maxLength": 1000
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "default": "now"
        }
      ],
      "indexes": [
        {
          "fields": [
            "dentistId",
            "startAt"
          ],
          "name": "idx_appointment_dentist_time"
        }
      ]
    }
  ],
  "relationships": [
    {
      "name": "dentistAppointments",
      "type": "one-to-many",
      "from": "Dentist",
      "to": "Appointment",
      "foreignKey": "dentistId",
      "onDelete": "RESTRICT"
    },
    {
      "name": "treatmentAppointments",
      "type": "one-to-many",
      "from": "Treatment",
      "to": "Appointment",
      "foreignKey": "treatmentId",
      "onDelete": "RESTRICT"
    }
  ],
  "policies": [
    {
      "name": "frontDeskOnly",
      "type": "role",
      "roles": [
        "front_desk"
      ]
    },
    {
      "name": "ownAppointments",
      "type": "ownership",
      "ownerField": "patientId",
      "bypassRoles": [
        "front_desk"
      ]
    }
  ],
  "rules": [
    {
      "id": "noDentistDoubleBooking",
      "kind": "noOverlap",
      "entity": "Appointment",
      "params": {
        "start": "startAt",
        "end": "endAt",
        "scope": [
          "dentistId"
        ],
        "where": {
          "status": {
            "ne": "CANCELLED"
          }
        }
      },
      "description": "A dentist cannot have two overlapping appointments unless one is cancelled."
    },
    {
      "id": "appointmentStatusFlow",
      "kind": "transition",
      "entity": "Appointment",
      "params": {
        "field": "status",
        "transitions": {
          "REQUESTED": [
            "CONFIRMED",
            "CANCELLED"
          ],
          "CONFIRMED": [
            "COMPLETED",
            "CANCELLED"
          ]
        }
      },
      "description": "Appointments move from requested to confirmed or cancelled, and from confirmed to completed or cancelled."
    },
    {
      "id": "finishedAppointmentIsFinal",
      "kind": "immutableAfter",
      "entity": "Appointment",
      "params": {
        "field": "status",
        "states": [
          "CANCELLED",
          "COMPLETED"
        ]
      },
      "description": "Cancelled and completed appointments cannot be modified."
    }
  ],
  "operations": [
    {
      "operationId": "dentist.list",
      "type": "crud",
      "action": "list",
      "entity": "Dentist",
      "method": "GET",
      "path": "/dentists",
      "pagination": true,
      "search": [
        "name",
        "specialty"
      ],
      "sort": [
        "name",
        "specialty"
      ]
    },
    {
      "operationId": "dentist.get",
      "type": "crud",
      "action": "get",
      "entity": "Dentist",
      "method": "GET",
      "path": "/dentists/{id}"
    },
    {
      "operationId": "dentist.create",
      "type": "crud",
      "action": "create",
      "entity": "Dentist",
      "method": "POST",
      "path": "/dentists",
      "policy": "frontDeskOnly"
    },
    {
      "operationId": "dentist.update",
      "type": "crud",
      "action": "update",
      "entity": "Dentist",
      "method": "PATCH",
      "path": "/dentists/{id}",
      "policy": "frontDeskOnly"
    },
    {
      "operationId": "dentist.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Dentist",
      "method": "DELETE",
      "path": "/dentists/{id}",
      "policy": "frontDeskOnly"
    },
    {
      "operationId": "treatment.list",
      "type": "crud",
      "action": "list",
      "entity": "Treatment",
      "method": "GET",
      "path": "/treatments",
      "pagination": true,
      "search": [
        "name"
      ],
      "sort": [
        "price",
        "durationMinutes",
        "name"
      ]
    },
    {
      "operationId": "treatment.get",
      "type": "crud",
      "action": "get",
      "entity": "Treatment",
      "method": "GET",
      "path": "/treatments/{id}"
    },
    {
      "operationId": "treatment.create",
      "type": "crud",
      "action": "create",
      "entity": "Treatment",
      "method": "POST",
      "path": "/treatments",
      "policy": "frontDeskOnly"
    },
    {
      "operationId": "treatment.update",
      "type": "crud",
      "action": "update",
      "entity": "Treatment",
      "method": "PATCH",
      "path": "/treatments/{id}",
      "policy": "frontDeskOnly"
    },
    {
      "operationId": "treatment.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Treatment",
      "method": "DELETE",
      "path": "/treatments/{id}",
      "policy": "frontDeskOnly"
    },
    {
      "operationId": "appointment.create",
      "type": "crud",
      "action": "create",
      "entity": "Appointment",
      "method": "POST",
      "path": "/appointments",
      "auth": "jwt",
      "rules": [
        "noDentistDoubleBooking"
      ]
    },
    {
      "operationId": "appointment.list",
      "type": "crud",
      "action": "list",
      "entity": "Appointment",
      "method": "GET",
      "path": "/appointments",
      "policy": "ownAppointments",
      "pagination": true,
      "filters": [
        "dentistId",
        "treatmentId",
        "status",
        "startAt"
      ],
      "sort": [
        "startAt",
        "createdAt"
      ]
    },
    {
      "operationId": "appointment.get",
      "type": "crud",
      "action": "get",
      "entity": "Appointment",
      "method": "GET",
      "path": "/appointments/{id}",
      "policy": "ownAppointments"
    },
    {
      "operationId": "appointment.update",
      "type": "crud",
      "action": "update",
      "entity": "Appointment",
      "method": "PATCH",
      "path": "/appointments/{id}",
      "policy": "ownAppointments",
      "rules": [
        "appointmentStatusFlow",
        "finishedAppointmentIsFinal",
        "noDentistDoubleBooking"
      ]
    },
    {
      "operationId": "appointment.delete",
      "type": "crud",
      "action": "delete",
      "entity": "Appointment",
      "method": "DELETE",
      "path": "/appointments/{id}",
      "policy": "frontDeskOnly"
    },
    {
      "operationId": "appointment.countThisWeekOnStartAtWhereStatusConfirmed",
      "type": "aggregate",
      "entity": "Appointment",
      "method": "GET",
      "path": "/appointments/aggregate/count-this-week-on-start-at-where-status-confirmed",
      "summary": "Upcoming appointments this week",
      "aggregate": {
        "fn": "count",
        "period": "week",
        "dateField": "startAt",
        "filters": {
          "status": "CONFIRMED"
        }
      }
    },
    {
      "operationId": "appointment.countWhereStatusRequested",
      "type": "aggregate",
      "entity": "Appointment",
      "method": "GET",
      "path": "/appointments/aggregate/count-where-status-requested",
      "summary": "New requests to review",
      "aggregate": {
        "fn": "count",
        "filters": {
          "status": "REQUESTED"
        }
      }
    },
    {
      "operationId": "appointment.countThisDayOnStartAt",
      "type": "aggregate",
      "entity": "Appointment",
      "method": "GET",
      "path": "/appointments/aggregate/count-this-day-on-start-at",
      "summary": "Appointments today",
      "aggregate": {
        "fn": "count",
        "period": "day",
        "dateField": "startAt"
      }
    },
    {
      "operationId": "appointment.countByStatus",
      "type": "aggregate",
      "entity": "Appointment",
      "method": "GET",
      "path": "/appointments/aggregate/count-by-status",
      "summary": "Appointments by status",
      "aggregate": {
        "fn": "count",
        "groupBy": "status"
      }
    }
  ],
