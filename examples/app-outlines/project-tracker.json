{
  "name": "Project Tracker",
  "tagline": "Projects and their tasks, in one place",
  "icon": "FolderKanban",
  "nav": [
    {"entity": "Project", "label": "Projects", "icon": "Folder"},
    {"entity": "Task", "label": "Tasks", "icon": "ListChecks"}
  ],
  "home": "dashboard",
  "entities": {
    "Project": {"listFields": ["name", "createdAt"], "listStyle": "table", "fieldLabels": {"createdAt": "Created"}},
    "Task": {
      "listFields": ["title", "projectId", "status", "priority", "dueDate"],
      "fieldLabels": {"projectId": "Project", "dueDate": "Due"},
      "help": {"priority": "1 is the most urgent, 5 the least"}
    }
  },
  "dashboard": [
    {"label": "Projects", "entity": "Project", "fn": "count"},
    {"label": "Open tasks", "entity": "Task", "fn": "count", "filter": {"status": "TODO"}},
    {"label": "Tasks by status", "kind": "bar", "entity": "Task", "fn": "count", "groupBy": "status"}
  ]
}
