          "badge": "quantity"
        }
      },
      "Order": {
        "view": "cards",
        "roles": {
          "title": "id",
          "badge": "status",
          "price": "totalAmount",
          "meta": "createdAt"
        }
      }
    },
    "looks": [
      {
        "recipe": "editorial",
        "reason": "Rich typography and elegant editorial framing that celebrate vibrant plant photography and care notes."
      },
      {
        "recipe": "minimal",
        "reason": "Crisp whitespace and clean lines that let lush greenery and natural leaf tones stand out without distraction."
      },
      {
        "recipe": "soft",
        "reason": "Gentle organic curves and subtle elevated surfaces reflecting an inviting, tactile greenhouse atmosphere."
      }
    ],
    "reason": "Shoppers browse a visual plant storefront with immediate filtering by light and size, while the owner operates a focused back-office dashboard to manage stock and advance order fulfillment."
  },
