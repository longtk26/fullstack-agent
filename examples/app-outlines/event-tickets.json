            "stat": "capacity"
          }
        }
      }
    },
    {
      "id": "organizers",
      "label": "Venue Management",
      "roles": [
        "organizer"
      ],
      "archetype": "back-office",
      "shell": "sidebar",
      "mobileNav": "drawer",
      "homeView": "dashboard",
