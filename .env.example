# Copy with `make env` (fills HOST_WORKSPACE_ROOT and a random JWT_SECRET), then edit.

# Host ports (defaults avoid the usual 3000/5432/6379)
BGA_API_PORT=8100
BGA_UI_PORT=3100
BGA_PG_PORT=5442
BGA_REDIS_PORT=6389

POSTGRES_USER=bga
POSTGRES_PASSWORD=bga
POSTGRES_DB=agent

# At least 32 random characters. The API refuses to start with the example value.
JWT_SECRET=change-me-to-a-long-random-string
# email:password[:role], comma separated. Roles: USER (default), ADMIN.
SEED_USERS=admin@bga.local:admin12345:ADMIN,user@bga.local:user12345

# Absolute host path for job workspaces; mounted at the same path inside the worker.
HOST_WORKSPACE_ROOT=/absolute/path/to/backend-generation-agent/.data/workspaces

LOG_LEVEL=INFO
WORKER_CONCURRENCY=2

# Code engines (Epic 3)
ANTHROPIC_API_KEY=

# Tracing (Epic 8, optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=backend-generation-agent

# Later epics: SANDBOX_CPU, SANDBOX_MEMORY, JOB_TIMEOUT_SECONDS, PREVIEW_PORT_RANGE
